{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StageCodeFilesOnce",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::${DATA_BUCKET_NAME}/lakehouse/run_stage/*/inputs/code.*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:if-none-match": "*"
        }
      }
    },
    {
      "Sid": "NameCurrentCodeRun",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter"
      ],
      "Resource": [
        "arn:aws:ssm:${AWS_REGION}:${AWS_ACCOUNT_ID}:parameter/${PROJECT_NAME}/current_code_run"
      ]
    },
    {
      "Sid": "DenyIam",
      "Effect": "Deny",
      "Action": "iam:*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyOrganizationsAccountAndBudgets",
      "Effect": "Deny",
      "Action": [
        "account:*",
        "budgets:*",
        "organizations:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyAssumeRoleOutsideProject",
      "Effect": "Deny",
      "Action": "sts:AssumeRole",
      "NotResource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_*"
    }
  ]
}
