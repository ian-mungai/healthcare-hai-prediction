#!/bin/bash
# Runs once per instance. Every command that can stall runs under a deadline, and the script stops at the first failure.
# The core dump settings and the metadata firewall come first and ECS_CLUSTER is written last, so no task runs without
# them and a host whose data volume did not mount never joins the cluster. Every line the script and its commands write
# goes to the log and, with the prefix below, to the serial console, which the project user can read after the instance
# ends (ec2:GetConsoleOutput). The last line states success, or the failing exit status, line and step.
set -euo pipefail
log_file="/var/log/platform_boot.log"
console_device="/dev/console"
fstab_file="/etc/fstab"
ecs_config_file="/etc/ecs/ecs.config"
device_directory="/dev/disk/by-id"
systemd_directory="/etc/systemd/system"
sysctl_file="/etc/sysctl.d/90-platform-core-dumps.conf"
nft_rules_file="/etc/nftables/platform_imds.nft"
nftables_config="/etc/sysconfig/nftables.conf"
guard_script="/usr/local/sbin/platform_imds_guard"
exec >>"$log_file" 2>&1
console_prefix="platform_boot:"
console_flush_seconds=4
stop_file="$log_file.stop"
current_step="starting"
region="${region}"
mount_path="${mount_path}"
data_volume_name="${data_volume_name}"
scratch_volume_name="${scratch_volume_name}"
scratch_path="${scratch_path}"
address_name="${address_name}"
interface_name="${interface_name}"
interface_poll_seconds=5
interface_attach_seconds=600
interface_wait_seconds=120
project_tag="${project_tag}"

# log and step write to the error stream, which command substitutions leave alone and which goes to the log.
log() { printf '[%ss] %s\n' "$SECONDS" "$*" >&2; }
step() {
  current_step=$1
  log "$1"
}

# A separate process copies each line of the log to the console, so a console that fails or blocks never stops a boot
# step. It polls the log, writes one prefixed line at a time and stops after one more pass once the stop file exists.
# The exit handler creates that file after the last line is in the log, waits for the copy up to the flush limit and
# then ends it, so a console that never accepts a write delays the end of the boot by the limit and no more.
copy_log_to_console() {
  local line pending="" stopping
  exec 3<"$log_file"
  while :; do
    stopping=0
    if [ -e "$stop_file" ]; then stopping=1; fi
    while IFS= read -r -u 3 line; do
      printf '%s %s%s\n' "$console_prefix" "$pending" "$line" 2>/dev/null >>"$console_device" || :
      pending=""
    done
    pending+=$line
    if [ "$stopping" -eq 1 ]; then
      if [ -n "$pending" ]; then printf '%s %s\n' "$console_prefix" "$pending" 2>/dev/null >>"$console_device" || :; fi
      break
    fi
    sleep 0.5
  done
}
stop_console_copy() {
  local waited=0
  : >"$stop_file" || return 0
  while kill -0 "$copy_pid" 2>/dev/null; do
    if [ "$waited" -ge $((console_flush_seconds * 4)) ]; then
      kill -KILL "$copy_pid" 2>/dev/null || :
      break
    fi
    sleep 0.25
    waited=$((waited + 1))
  done
}
finish() {
  local status=$? line=$1
  trap - EXIT
  set +e
  if [ "$status" -eq 0 ]; then
    log "finished: every step succeeded and ECS_CLUSTER is written."
  else
    log "FAILED: exit status $status at line $line during: $current_step"
  fi
  stop_console_copy
}
rm -f "$stop_file"
copy_log_to_console </dev/null >/dev/null 2>&1 &
copy_pid=$!
trap 'finish $LINENO' EXIT
trap 'exit 143' TERM HUP INT
log "Copying this log to the console as lines that start with \"$console_prefix\" (process $copy_pid)."

# A command substitution runs in a subshell, which loses current_step, so the shell sets current_step before each substitution.
# GNU timeout sends TERM at the deadline and KILL 10 seconds later, so a command that ignores TERM still ends. Status
# 124 means TERM stopped it and 137 means KILL did.
run_within() {
  local seconds=$1 step=$2 status=0
  shift 2
  current_step=$step
  log "starting: $step (limit $seconds seconds)"
  timeout --kill-after=10 "$seconds" "$@" || status=$?
  if [ "$status" -eq 124 ]; then echo "$step did not finish within $seconds seconds." >&2; fi
  if [ "$status" -eq 137 ]; then
    echo "$step did not finish within $seconds seconds and ignored the stop signal, so it was killed 10 seconds later." >&2
  fi
  log "ended: $step (status $status)"
  return "$status"
}

# A pipe handler in kernel.core_pattern receives core dumps even when a container's core limit is zero, so cores are
# plain files, which the zero limit stops, and set-user-ID programs never dump. This file sorts after the image's
# systemd-coredump setting, so it also wins at every later boot.
step "Writing the core dump settings"
mkdir -p "$(dirname "$sysctl_file")"
cat >"$sysctl_file" <<'SYSCTL'
kernel.core_pattern = core
fs.suid_dumpable = 0
SYSCTL
run_within 30 "Applying the core dump settings" sysctl -q -p "$sysctl_file"
current_step="Reading the core dump pattern"
core_pattern=$(run_within 30 "$current_step" sysctl -n kernel.core_pattern)
current_step="Reading the set-user-ID dump setting"
suid_dumpable=$(run_within 30 "$current_step" sysctl -n fs.suid_dumpable)
if [ "$core_pattern" != "core" ] || [ "$suid_dumpable" != "0" ]; then
  echo "The core dump settings did not take effect (pattern $core_pattern, set-user-ID dumps $suid_dumpable)."
  exit 1
fi

# Host-network containers share the host's network, so only root (the ECS agent, ecs-init and the Session Manager agent)
# may reach the instance metadata service and the host role. Job containers use the bridge network, so a second table in the
# same file limits what the bridge may reach (see host_job_firewall.nft). One file is one transaction, so the guard, the
# firewall configuration and every reload load both tables together. The rule has its own nftables table, which Docker, firewalld
# and reloads of the xtables rule sets leave alone. The nftables configuration includes it, so a reload of that service loads it again in the
# same transaction, and the guard unit is part of that service, so stopping or restarting it stops or restarts Docker
# and the ECS agent too. Both require the guard and load and check the rule before every start. A timer checks both tables
# every 10 seconds, loads them again when either is missing and stops both services when it cannot.
# Docker and the ECS agent also require the scratch mount at every start, not only during this first boot: its fstab line
# is nofail, so on a later boot without it the job folders would land on the snapshotted data volume underneath.
# RequiresMountsFor makes each service require the mount unit, and ExecStartPre checks the mount itself, so a start fails
# while the scratch volume is not mounted.
step "Writing the metadata firewall files"
command -v nft >/dev/null || run_within 300 "Installing nftables" dnf install -y -q nftables
mkdir -p "$(dirname "$nft_rules_file")" "$(dirname "$guard_script")" "$systemd_directory/docker.service.d" "$systemd_directory/ecs.service.d"
cat >"$nft_rules_file" <<'RULES'
table inet platform_imds
delete table inet platform_imds
table inet platform_imds {
  chain output {
    type filter hook output priority -10; policy accept;
    ip daddr 169.254.169.254 meta skuid != 0 drop
  }
}
${job_firewall_rules}RULES
include_line="include \"$nft_rules_file\""
grep -qxF "$include_line" "$nftables_config" 2>/dev/null || echo "$include_line" >>"$nftables_config"
{
  echo '#!/bin/bash'
  printf 'rules_file=%q\n' "$nft_rules_file"
  cat <<'GUARD'
# apply loads both tables in one transaction and checks them. check confirms that the metadata table and the job table
# both exist and that user 65534 cannot connect to the metadata service (curl status 7 or 28). enforce loads both tables
# again when either is missing and stops the ECS agent and Docker when it cannot.
probe_blocked() {
  local status=0
  timeout --kill-after=5 10 setpriv --reuid=65534 --regid=65534 --clear-groups -- curl -s -o /dev/null --max-time 3 http://169.254.169.254/latest/meta-data/ || status=$?
  [ "$status" -eq 7 ] || [ "$status" -eq 28 ]
}
check() {
  timeout --kill-after=5 30 nft list table inet platform_imds >/dev/null \
    && timeout --kill-after=5 30 nft list table inet platform_jobs >/dev/null \
    && probe_blocked
}
apply() {
  timeout --kill-after=5 30 nft -f "$rules_file" || { echo "Could not load the metadata firewall rule." >&2; return 1; }
  check || { echo "The metadata firewall rule did not stop a non-root user." >&2; return 1; }
}
if [ "$#" -ne 1 ]; then echo "Usage: platform_imds_guard apply|check|enforce" >&2; exit 2; fi
case "$1" in
  apply) apply ;;
  check) check ;;
  enforce)
    check && exit 0
    echo "The metadata firewall check failed; loading the rule again." >&2
    apply && exit 0
    echo "The metadata firewall could not be restored; stopping the ECS agent and Docker." >&2
    timeout --kill-after=10 300 systemctl stop ecs.service docker.service docker.socket
    exit 1
    ;;
  *) echo "Usage: platform_imds_guard apply|check|enforce" >&2; exit 2 ;;
esac
GUARD
} >"$guard_script"
chmod 0755 "$guard_script"
cat >"$systemd_directory/platform_imds_guard.service" <<UNIT
[Unit]
Description=Drop instance metadata traffic from every user except root
After=nftables.service
Before=docker.service ecs.service
PartOf=nftables.service
ReloadPropagatedFrom=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
ExecStart=$guard_script apply
ExecReload=$guard_script apply

[Install]
WantedBy=multi-user.target
UNIT
for unit in docker.service ecs.service; do
  cat >"$systemd_directory/$unit.d/platform_imds_guard.conf" <<UNIT
[Unit]
Requires=platform_imds_guard.service
After=platform_imds_guard.service

[Service]
ExecStartPre=$guard_script apply
UNIT
done
mountpoint_command=$(command -v mountpoint)
for unit in docker.service ecs.service; do
  cat >"$systemd_directory/$unit.d/platform_scratch_mount.conf" <<UNIT
[Unit]
RequiresMountsFor=$scratch_path

[Service]
ExecStartPre=$mountpoint_command -q $scratch_path
UNIT
done
cat >"$systemd_directory/platform_imds_watch.service" <<UNIT
[Unit]
Description=Check the metadata firewall and stop the ECS agent and Docker when it cannot be restored
After=platform_imds_guard.service

[Service]
Type=oneshot
TimeoutStartSec=400
ExecStart=$guard_script enforce
UNIT
cat >"$systemd_directory/platform_imds_watch.timer" <<'UNIT'
[Unit]
Description=Check the metadata firewall every 10 seconds

[Timer]
OnActiveSec=10s
OnUnitActiveSec=10s
AccuracySec=1s

[Install]
WantedBy=timers.target
UNIT
run_within 60 "Reloading systemd units" systemctl daemon-reload
run_within 120 "Starting the metadata firewall" systemctl enable --now platform_imds_guard.service || {
  echo "The metadata firewall did not start, so the host does not join the cluster."
  exit 1
}
run_within 60 "Checking the metadata firewall" "$guard_script" check
run_within 60 "Starting the metadata firewall timer" systemctl enable --now platform_imds_watch.timer

# The launch template and the Auto Scaling group are fixed and the data volume and Elastic IP are created later, so boot
# finds each by its Name and Project tags with the host role's two describe calls. Exactly one of each must exist and its
# ID must have the expected shape before it reaches the AWS CLI. The instance ID comes from the metadata service, which
# only root may reach.
metadata_get() {
  curl -sf --max-time 10 -H "X-aws-ec2-metadata-token: $token" "http://169.254.169.254/latest/meta-data/$1"
}
step "Reading the instance metadata"
token=$(curl -sf --max-time 10 -X PUT -H "X-aws-ec2-metadata-token-ttl-seconds: 600" http://169.254.169.254/latest/api/token) || {
  echo "The metadata token request failed, so the host does not join the cluster."
  exit 1
}
instance=$(metadata_get instance-id) || { echo "The instance ID could not be read."; exit 1; }
command -v aws >/dev/null || run_within 300 "Installing the AWS CLI" dnf install -y -q awscli-2
current_step="Finding the data volume"
volume=$(run_within 60 "$current_step" aws ec2 describe-volumes --region "$region" --filters "Name=tag:Name,Values=$data_volume_name" "Name=tag:Project,Values=$project_tag" --query "Volumes[].VolumeId" --output text) || {
  echo "The data volume could not be listed."
  exit 1
}
current_step="Finding the Elastic IP"
allocation=$(run_within 60 "$current_step" aws ec2 describe-addresses --region "$region" --filters "Name=tag:Name,Values=$address_name" "Name=tag:Project,Values=$project_tag" --query "Addresses[].AllocationId" --output text) || {
  echo "The Elastic IP could not be listed."
  exit 1
}
current_step="Finding the scratch volume"
scratch=$(run_within 60 "$current_step" aws ec2 describe-volumes --region "$region" --filters "Name=tag:Name,Values=$scratch_volume_name" "Name=tag:Project,Values=$project_tag" --query "Volumes[].VolumeId" --output text) || {
  echo "The scratch volume could not be listed."
  exit 1
}
current_step="Finding the host network interface"
interface=$(run_within 60 "$current_step" aws ec2 describe-network-interfaces --region "$region" --filters "Name=tag:Name,Values=$interface_name" "Name=tag:Project,Values=$project_tag" --query "NetworkInterfaces[].[NetworkInterfaceId,PrivateIpAddress]" --output text) || {
  echo "The host network interface could not be listed."
  exit 1
}
[[ "$volume" =~ ^vol-[0-9a-f]{8,17}$ ]] || { echo "Exactly one data volume must carry the project tags, but the search did not return one volume ID."; exit 1; }
[[ "$allocation" =~ ^eipalloc-[0-9a-f]{8,17}$ ]] || { echo "Exactly one Elastic IP must carry the project tags, but the search did not return one allocation ID."; exit 1; }
[[ "$scratch" =~ ^vol-[0-9a-f]{8,17}$ ]] || { echo "Exactly one scratch volume must carry the project tags, but the search did not return one volume ID."; exit 1; }
[[ "$interface" =~ ^eni-[0-9a-f]{8,17}[[:blank:]]+([0-9]{1,3}(\.[0-9]{1,3}){3})$ ]] || { echo "Exactly one network interface must carry the host address tags, but the search did not return one interface ID and address."; exit 1; }
read -r interface_id interface_ip <<<"$interface"
run_within 60 "Checking the Session Manager agent" rpm -q amazon-ssm-agent >/dev/null || run_within 300 "Installing the Session Manager agent" dnf install -y -q amazon-ssm-agent
run_within 120 "Starting the Session Manager agent" systemctl enable --now amazon-ssm-agent
run_within 60 "Associating the Elastic IP" aws ec2 associate-address --region "$region" --allocation-id "$allocation" --instance-id "$instance" --allow-reassociation >/dev/null
# The host keeps one private address: the tagged network interface of the IAM stack, attached as the second interface before the volumes and before
# ECS joins. An interface that is already attached to this instance counts as attached. One that is free is attached; one that an instance that is
# going away still holds is waited for. The operating system then shows the address on the new interface (amazon-ec2-net-utils configures a
# hot-plugged interface and its route), which the script checks before the services start, so the address that Terraform exports is the one they listen on.
attached_instance() {
  run_within 60 "Reading the host network interface attachment" aws ec2 describe-network-interfaces --region "$region" --network-interface-ids "$interface_id" --query "NetworkInterfaces[0].Attachment.InstanceId" --output text
}
deadline=$((SECONDS + interface_attach_seconds))
current_step="Reading the host network interface attachment"
holder=$(attached_instance) || {
  echo "The host network interface attachment could not be read."
  exit 1
}
while [ "$holder" != "$instance" ]; do
  if ((SECONDS >= deadline)); then echo "The host network interface did not attach within $interface_attach_seconds seconds."; exit 1; fi
  if [ "$holder" = "None" ]; then
    run_within 60 "Attaching the host network interface" aws ec2 attach-network-interface --region "$region" --network-interface-id "$interface_id" --instance-id "$instance" --device-index 1 >/dev/null || echo "The attach call failed; reading the attachment again." >&2
  fi
  sleep "$interface_poll_seconds"
  current_step="Reading the host network interface attachment"
  holder=$(attached_instance) || {
    echo "The host network interface attachment could not be read."
    exit 1
  }
done
step "Waiting for the host address"
deadline=$((SECONDS + interface_wait_seconds))
while :; do
  current_step="Waiting for the host address"
  shown=$(run_within 30 "Reading the addresses of the host" ip -o -4 addr show to "$interface_ip") || {
    echo "The addresses of the host could not be read."
    exit 1
  }
  if [ -n "$shown" ]; then break; fi
  if ((SECONDS >= deadline)); then echo "The host address did not come up within $interface_wait_seconds seconds."; exit 1; fi
  sleep "$interface_poll_seconds"
done
log "The host address $interface_ip is up on $interface_id."
deadline=$((SECONDS + 600))
until run_within 60 "Attaching the data volume" aws ec2 attach-volume --region "$region" --volume-id "$volume" --instance-id "$instance" --device /dev/xvdf >/dev/null; do
  if ((SECONDS >= deadline)); then echo "The data volume did not attach within 600 seconds."; exit 1; fi
  sleep 15
done
step "Waiting for the data volume device"
device_link="$device_directory/nvme-Amazon_Elastic_Block_Store_$(echo "$volume" | tr -d -)"
deadline=$((SECONDS + 300))
until [ -e "$device_link" ]; do
  if ((SECONDS >= deadline)); then echo "The data volume device did not appear within 300 seconds."; exit 1; fi
  sleep 5
done
device=$(readlink -f "$device_link")
status=0
run_within 60 "Reading the data volume's file system" blkid -p "$device" || status=$?
if [ "$status" -eq 2 ]; then
  run_within 300 "Formatting the data volume" mkfs.xfs "$device"
elif [ "$status" -ne 0 ]; then
  echo "Could not read the data volume's file system (blkid status $status)."
  exit 1
fi
current_step="Reading the data volume's UUID"
uuid=$(run_within 60 "$current_step" blkid -s UUID -o value "$device")
mkdir -p "$mount_path"
grep -q "UUID=$uuid" "$fstab_file" || echo "UUID=$uuid $mount_path xfs defaults,nofail 0 2" >>"$fstab_file"
run_within 30 "Checking the data mount" mountpoint -q "$mount_path" || run_within 120 "Mounting the data volume" mount "$mount_path"
run_within 120 "Growing the data volume file system" xfs_growfs "$mount_path"

# The scratch volume holds the job work folders and is not snapshotted. It mounts under the data mount, so the data volume must be
# mounted first. The host does not join the cluster without it, because a job would otherwise write its files to the data volume.
deadline=$((SECONDS + 600))
until run_within 60 "Attaching the scratch volume" aws ec2 attach-volume --region "$region" --volume-id "$scratch" --instance-id "$instance" --device /dev/xvdg >/dev/null; do
  if ((SECONDS >= deadline)); then echo "The scratch volume did not attach within 600 seconds."; exit 1; fi
  sleep 15
done
step "Waiting for the scratch volume device"
scratch_link="$device_directory/nvme-Amazon_Elastic_Block_Store_$(echo "$scratch" | tr -d -)"
deadline=$((SECONDS + 300))
until [ -e "$scratch_link" ]; do
  if ((SECONDS >= deadline)); then echo "The scratch volume device did not appear within 300 seconds."; exit 1; fi
  sleep 5
done
scratch_device=$(readlink -f "$scratch_link")
status=0
run_within 60 "Reading the scratch volume's file system" blkid -p "$scratch_device" || status=$?
if [ "$status" -eq 2 ]; then
  run_within 300 "Formatting the scratch volume" mkfs.xfs "$scratch_device"
elif [ "$status" -ne 0 ]; then
  echo "Could not read the scratch volume's file system (blkid status $status)."
  exit 1
fi
current_step="Reading the scratch volume's UUID"
scratch_uuid=$(run_within 60 "$current_step" blkid -s UUID -o value "$scratch_device")
mkdir -p "$scratch_path"
grep -q "UUID=$scratch_uuid" "$fstab_file" || echo "UUID=$scratch_uuid $scratch_path xfs defaults,nofail 0 2" >>"$fstab_file"
run_within 30 "Checking the scratch mount before mounting" mountpoint -q "$scratch_path" || run_within 120 "Mounting the scratch volume" mount "$scratch_path"
run_within 120 "Growing the scratch volume file system" xfs_growfs "$scratch_path"
run_within 30 "Checking the scratch mount" mountpoint -q "$scratch_path" || {
  echo "The scratch volume is not mounted, so the host does not join the cluster."
  exit 1
}
# systemd reads the new fstab lines, so the mount units that RequiresMountsFor names exist before Docker or the ECS agent starts.
run_within 60 "Reloading systemd units for the new mounts" systemctl daemon-reload
step "Writing the ECS agent configuration"
cat >>"$ecs_config_file" <<CONFIG
ECS_ENABLE_TASK_IAM_ROLE=true
ECS_ENABLE_TASK_IAM_ROLE_NETWORK_HOST=true
ECS_ENABLE_AWSLOGS_EXECUTIONROLE_OVERRIDE=true
ECS_AWSVPC_BLOCK_IMDS=true
ECS_DISABLE_PRIVILEGED=true
ECS_CLUSTER=${cluster_name}
CONFIG
