{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassTaskRolesToEcsTasks",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_task_execution_${ENVIRONMENT}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_polaris_task_${ENVIRONMENT}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_control_plane_task_${ENVIRONMENT}"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassSnapshotRoleToDataLifecycleManager",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_snapshots_${ENVIRONMENT}",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "dlm.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassE2eWriterRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_write_e2e_task_${ENVIRONMENT}",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassReadJobRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_execution_${ENVIRONMENT}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_offline_task_${ENVIRONMENT}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_seal_task_${ENVIRONMENT}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_read_task_${ENVIRONMENT}"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassLayerWriterRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_write_silver_task_${ENVIRONMENT}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_write_gold_task_${ENVIRONMENT}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_write_features_task_${ENVIRONMENT}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_write_bronze_task_${ENVIRONMENT}"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassTrainingRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_train_task_${ENVIRONMENT}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_mlflow_task_${ENVIRONMENT}"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassBrokerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_broker_task_${ENVIRONMENT}",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "SimulateProjectRoles",
      "Effect": "Allow",
      "Action": "iam:SimulatePrincipalPolicy",
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_*_${ENVIRONMENT}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${LAKEHOUSE_READER_ROLE_NAME}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${LAKEHOUSE_WRITER_ROLE_NAME}"
      ]
    }
  ]
}
