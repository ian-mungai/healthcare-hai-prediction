{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageAlertTopics",
      "Effect": "Allow",
      "Action": [
        "sns:*"
      ],
      "Resource": [
        "arn:aws:sns:${AWS_REGION}:${AWS_ACCOUNT_ID}:${PROJECT_NAME}_alerts_${ENVIRONMENT}",
        "arn:aws:sns:${AWS_REGION}:${AWS_ACCOUNT_ID}:${PROJECT_NAME}_alerts_${ENVIRONMENT}:*",
        "arn:aws:sns:${AWS_REGION}:${AWS_ACCOUNT_ID}:${PROJECT_NAME}_budget_alerts_${ENVIRONMENT}",
        "arn:aws:sns:${AWS_REGION}:${AWS_ACCOUNT_ID}:${PROJECT_NAME}_budget_alerts_${ENVIRONMENT}:*"
      ]
    },
    {
      "Sid": "DenyTopicWithoutProjectTagValue",
      "Effect": "Deny",
      "Action": [
        "sns:CreateTopic"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestTag/Project": "${PROJECT_NAME}"
        }
      }
    },
    {
      "Sid": "DenyTopicWithoutExactProjectKey",
      "Effect": "Deny",
      "Action": [
        "sns:CreateTopic"
      ],
      "Resource": "*",
      "Condition": {
        "ForAllValues:StringNotEquals": {
          "aws:TagKeys": [
            "Project"
          ]
        }
      }
    },
    {
      "Sid": "DenyRemovingProjectTag",
      "Effect": "Deny",
      "Action": [
        "sns:UntagResource"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEqualsIgnoreCase": {
          "aws:TagKeys": [
            "Project"
          ]
        }
      }
    },
    {
      "Sid": "DenyChangingProjectTag",
      "Effect": "Deny",
      "Action": [
        "sns:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEqualsIgnoreCase": {
          "aws:TagKeys": [
            "Project"
          ]
        },
        "StringNotEquals": {
          "aws:RequestTag/Project": "${PROJECT_NAME}"
        }
      }
    }
  ]
}
