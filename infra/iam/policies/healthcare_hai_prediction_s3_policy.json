{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateApprovedBucketInApprovedRegion",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}",
      "Condition": {
        "StringEquals": {
          "s3:LocationConstraint": "${AWS_REGION}"
        }
      }
    },
    {
      "Sid": "ReadApprovedBucketConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketWebsite",
        "s3:GetBucketVersioning",
        "s3:GetBucketLogging",
        "s3:GetBucketNotification",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketTagging",
        "s3:GetAccelerateConfiguration",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration"
      ],
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}"
    },
    {
      "Sid": "ManageApprovedBucketSecurity",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketVersioning",
        "s3:PutLifecycleConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPolicy",
        "s3:PutBucketTagging"
      ],
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}"
    },
    {
      "Sid": "InspectApprovedAcquisitionBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}"
    },
    {
      "Sid": "CaptureAndVerifyApprovedPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes",
        "s3:PutObject",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::${DATA_BUCKET_NAME}/raw/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/reference/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/manifests/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/audit/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/*/data/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/*/references/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/*/manifests/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/*/audit/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/*/*/datasets/*"
      ]
    },
    {
      "Sid": "ManageLakehouseTables",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/lakehouse/*"
    },
    {
      "Sid": "ReadSingleCopyContentObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_objects/sha256/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_evidence/sha256/*"
      ]
    },
    {
      "Sid": "CreateSingleCopyContentObjectsOnce",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_objects/sha256/????????????????????????????????????????????????????????????????",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_evidence/sha256/????????????????????????????????????????????????????????????????"
      ],
      "Condition": {
        "Null": {
          "s3:if-none-match": "false"
        }
      }
    },
    {
      "Sid": "DenyOlderGrantsInSingleCopyFolders",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectTagging",
        "s3:PutObjectVersionTagging",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_objects/data/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_objects/references/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_objects/manifests/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_objects/audit/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_objects/*/*/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_evidence/data/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_evidence/references/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_evidence/manifests/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_evidence/audit/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_evidence/*/*/*"
      ]
    },
    {
      "Sid": "DenyPercentSignInSingleCopyKeys",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_objects/sha256/*%*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/bronze_evidence/sha256/*%*"
      ]
    },
    {
      "Sid": "ReadStageVersions",
      "Effect": "Allow",
      "Action": "s3:GetObjectVersion",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/lakehouse/run_stage/*"
    }
  ]
}
