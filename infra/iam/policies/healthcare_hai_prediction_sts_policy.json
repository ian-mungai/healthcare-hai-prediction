{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeLakehouseRolesOnly",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole"
      ],
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${LAKEHOUSE_READER_ROLE_NAME}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${LAKEHOUSE_WRITER_ROLE_NAME}"
      ]
    },
    {
      "Sid": "AssumeAthenaReaderOnly",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole"
      ],
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_athena_reader_${ENVIRONMENT}"
    },
    {
      "Sid": "AssumeTryOutputRole",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_try_writer_${ENVIRONMENT}",
      "Condition": {
        "StringLike": {
          "sts:RoleSessionName": "hai_try_*"
        }
      }
    }
  ]
}
