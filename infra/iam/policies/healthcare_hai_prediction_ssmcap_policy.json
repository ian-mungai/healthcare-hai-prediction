{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SetHostLaunchHold",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter"
      ],
      "Resource": [
        "arn:aws:ssm:${AWS_REGION}:${AWS_ACCOUNT_ID}:parameter${HOST_LAUNCH_HOLD_PARAMETER_NAME}"
      ]
    },
    {
      "Sid": "ManageServicesApplyLock",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:DeleteParameter"
      ],
      "Resource": [
        "arn:aws:ssm:${AWS_REGION}:${AWS_ACCOUNT_ID}:parameter${SERVICES_APPLY_LOCK_PARAMETER_NAME}"
      ]
    }
  ]
}
