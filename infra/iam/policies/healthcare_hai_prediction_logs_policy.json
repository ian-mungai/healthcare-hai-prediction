{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateTaggedLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:${AWS_REGION}:${AWS_ACCOUNT_ID}:log-group:${PROJECT_NAME}_*_${ENVIRONMENT}",
        "arn:aws:logs:${AWS_REGION}:${AWS_ACCOUNT_ID}:log-group:${PROJECT_NAME}_*_${ENVIRONMENT}:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "${PROJECT_NAME}"
        },
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "Project"
          ]
        }
      }
    },
    {
      "Sid": "ManageProjectLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:ListTagsForResource",
        "logs:ListTagsLogGroup",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": [
        "arn:aws:logs:${AWS_REGION}:${AWS_ACCOUNT_ID}:log-group:${PROJECT_NAME}_*_${ENVIRONMENT}",
        "arn:aws:logs:${AWS_REGION}:${AWS_ACCOUNT_ID}:log-group:${PROJECT_NAME}_*_${ENVIRONMENT}:*"
      ]
    },
    {
      "Sid": "ReadProjectLogEvents",
      "Effect": "Allow",
      "Action": [
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:${AWS_REGION}:${AWS_ACCOUNT_ID}:log-group:${PROJECT_NAME}_*_${ENVIRONMENT}",
        "arn:aws:logs:${AWS_REGION}:${AWS_ACCOUNT_ID}:log-group:${PROJECT_NAME}_*_${ENVIRONMENT}:*"
      ]
    },
    {
      "Sid": "DescribeLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${AWS_REGION}"
        }
      }
    },
    {
      "Sid": "DenyLogGroupsWithoutProjectTagValue",
      "Effect": "Deny",
      "Action": [
        "logs:CreateLogGroup"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestTag/Project": "${PROJECT_NAME}"
        }
      }
    },
    {
      "Sid": "DenyLogGroupsWithoutExactProjectKey",
      "Effect": "Deny",
      "Action": [
        "logs:CreateLogGroup"
      ],
      "Resource": "*",
      "Condition": {
        "ForAllValues:StringNotEquals": {
          "aws:TagKeys": [
            "Project"
          ]
        }
      }
    },
    {
      "Sid": "DenyRemovingProjectTag",
      "Effect": "Deny",
      "Action": [
        "logs:UntagResource"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEqualsIgnoreCase": {
          "aws:TagKeys": [
            "Project"
          ]
        }
      }
    },
    {
      "Sid": "DenyChangingProjectTag",
      "Effect": "Deny",
      "Action": [
        "logs:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEqualsIgnoreCase": {
          "aws:TagKeys": [
            "Project"
          ]
        },
        "Null": {
          "aws:ResourceTag/Project": "false"
        }
      }
    }
  ]
}
