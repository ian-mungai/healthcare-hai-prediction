{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeAndListEcsResources",
      "Effect": "Allow",
      "Action": [
        "ecs:ListClusters",
        "ecs:ListTaskDefinitions",
        "ecs:ListTaskDefinitionFamilies",
        "ecs:DescribeTaskDefinition"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${AWS_REGION}"
        }
      }
    },
    {
      "Sid": "CreateTaggedClusterAndCapacityProvider",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateCluster",
        "ecs:CreateCapacityProvider"
      ],
      "Resource": [
        "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:cluster/${PROJECT_NAME}_cluster_${ENVIRONMENT}",
        "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:capacity-provider/${PROJECT_NAME}_host_${ENVIRONMENT}"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "${PROJECT_NAME}"
        },
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "Project"
          ]
        }
      }
    },
    {
      "Sid": "ManageProjectCluster",
      "Effect": "Allow",
      "Action": [
        "ecs:DeleteCluster",
        "ecs:DescribeClusters",
        "ecs:UpdateCluster",
        "ecs:UpdateClusterSettings",
        "ecs:PutClusterCapacityProviders",
        "ecs:ListContainerInstances",
        "ecs:ListTagsForResource"
      ],
      "Resource": "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:cluster/${PROJECT_NAME}_cluster_${ENVIRONMENT}"
    },
    {
      "Sid": "DescribeProjectContainerInstances",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeContainerInstances"
      ],
      "Resource": "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:container-instance/${PROJECT_NAME}_cluster_${ENVIRONMENT}/*"
    },
    {
      "Sid": "ManageProjectCapacityProvider",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateCapacityProvider",
        "ecs:DeleteCapacityProvider",
        "ecs:DescribeCapacityProviders",
        "ecs:ListTagsForResource"
      ],
      "Resource": "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:capacity-provider/${PROJECT_NAME}_host_${ENVIRONMENT}"
    },
    {
      "Sid": "CreateTaggedServicesThatPropagateTags",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateService"
      ],
      "Resource": "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:service/${PROJECT_NAME}_cluster_${ENVIRONMENT}/${PROJECT_NAME}_${ENVIRONMENT}_*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "${PROJECT_NAME}",
          "ecs:propagate-tags": [
            "SERVICE",
            "TASK_DEFINITION"
          ]
        },
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "Project"
          ]
        }
      }
    },
    {
      "Sid": "ManageProjectServices",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:DeleteService",
        "ecs:DescribeServices",
        "ecs:ListServices",
        "ecs:ListTagsForResource"
      ],
      "Resource": "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:service/${PROJECT_NAME}_cluster_${ENVIRONMENT}/${PROJECT_NAME}_${ENVIRONMENT}_*"
    },
    {
      "Sid": "ListServicesAndTasksOfProjectCluster",
      "Effect": "Allow",
      "Action": [
        "ecs:ListServices",
        "ecs:ListTasks"
      ],
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:cluster/${PROJECT_NAME}_cluster_${ENVIRONMENT}"
        }
      }
    },
    {
      "Sid": "DescribeServiceDeployments",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServiceDeployments",
        "ecs:ListServiceDeployments"
      ],
      "Resource": [
        "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:service/${PROJECT_NAME}_cluster_${ENVIRONMENT}/${PROJECT_NAME}_${ENVIRONMENT}_*",
        "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:service-deployment/${PROJECT_NAME}_cluster_${ENVIRONMENT}/${PROJECT_NAME}_${ENVIRONMENT}_*/*"
      ]
    },
    {
      "Sid": "RegisterTaggedTaskDefinitions",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition"
      ],
      "Resource": "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:task-definition/${PROJECT_NAME}_${ENVIRONMENT}_*:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "${PROJECT_NAME}"
        },
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "Project"
          ]
        }
      }
    },
    {
      "Sid": "RunTasksThatPropagateTags",
      "Effect": "Allow",
      "Action": [
        "ecs:RunTask"
      ],
      "Resource": "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:task-definition/${PROJECT_NAME}_${ENVIRONMENT}_*:*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:cluster/${PROJECT_NAME}_cluster_${ENVIRONMENT}"
        },
        "StringEquals": {
          "ecs:propagate-tags": "TASK_DEFINITION"
        }
      }
    },
    {
      "Sid": "ManageProjectTasks",
      "Effect": "Allow",
      "Action": [
        "ecs:StopTask",
        "ecs:DescribeTasks"
      ],
      "Resource": "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:task/${PROJECT_NAME}_cluster_${ENVIRONMENT}/*"
    },
    {
      "Sid": "TagWhileCreating",
      "Effect": "Allow",
      "Action": [
        "ecs:TagResource"
      ],
      "Resource": [
        "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:cluster/${PROJECT_NAME}_cluster_${ENVIRONMENT}",
        "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:capacity-provider/${PROJECT_NAME}_host_${ENVIRONMENT}",
        "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:service/${PROJECT_NAME}_cluster_${ENVIRONMENT}/${PROJECT_NAME}_${ENVIRONMENT}_*",
        "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:task-definition/${PROJECT_NAME}_${ENVIRONMENT}_*:*",
        "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:task/${PROJECT_NAME}_cluster_${ENVIRONMENT}/*"
      ],
      "Condition": {
        "StringEquals": {
          "ecs:CreateAction": [
            "CreateCluster",
            "CreateCapacityProvider",
            "CreateService",
            "RegisterTaskDefinition",
            "RunTask"
          ]
        }
      }
    },
    {
      "Sid": "DenyCreatesWithoutProjectTagValue",
      "Effect": "Deny",
      "Action": [
        "ecs:CreateCluster",
        "ecs:CreateCapacityProvider",
        "ecs:CreateService",
        "ecs:RegisterTaskDefinition"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestTag/Project": "${PROJECT_NAME}"
        }
      }
    },
    {
      "Sid": "DenyCreatesWithoutExactProjectKey",
      "Effect": "Deny",
      "Action": [
        "ecs:CreateCluster",
        "ecs:CreateCapacityProvider",
        "ecs:CreateService",
        "ecs:RegisterTaskDefinition"
      ],
      "Resource": "*",
      "Condition": {
        "ForAllValues:StringNotEquals": {
          "aws:TagKeys": [
            "Project"
          ]
        }
      }
    },
    {
      "Sid": "DenyServicesAndTasksThatDoNotPropagateTags",
      "Effect": "Deny",
      "Action": [
        "ecs:CreateService"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "ecs:propagate-tags": [
            "SERVICE",
            "TASK_DEFINITION"
          ]
        }
      }
    },
    {
      "Sid": "DenyRunTaskThatDoesNotPropagateTags",
      "Effect": "Deny",
      "Action": [
        "ecs:RunTask"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "ecs:propagate-tags": "TASK_DEFINITION"
        }
      }
    },
    {
      "Sid": "DenyAnotherProjectTagOnRunTaskServicesAndTags",
      "Effect": "Deny",
      "Action": [
        "ecs:RunTask",
        "ecs:CreateService",
        "ecs:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:RequestTag/Project": "false"
        },
        "StringNotEquals": {
          "aws:RequestTag/Project": "${PROJECT_NAME}"
        }
      }
    },
    {
      "Sid": "DenyUpdatesThatStopTagPropagation",
      "Effect": "Deny",
      "Action": [
        "ecs:UpdateService"
      ],
      "Resource": "*",
      "Condition": {
        "StringEqualsIgnoreCase": {
          "ecs:propagate-tags": "NONE"
        }
      }
    },
    {
      "Sid": "DenyTagChangesAfterCreate",
      "Effect": "Deny",
      "Action": [
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "ecs:CreateAction": "true"
        }
      }
    }
  ]
}
