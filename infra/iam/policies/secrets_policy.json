{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSharedSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": ${jsonencode([for name in SECRET_NAMES : "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:${name}-??????"])}
    },
    {
      "Sid": "ReadProjectParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter"
      ],
      "Resource": ${jsonencode([for name in READ_PARAMETER_NAMES : "arn:aws:ssm:${AWS_REGION}:${AWS_ACCOUNT_ID}:parameter${name}"])}
    },
    {
      "Sid": "WriteProjectParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter"
      ],
      "Resource": ${jsonencode([for name in MANAGED_PARAMETER_NAMES : "arn:aws:ssm:${AWS_REGION}:${AWS_ACCOUNT_ID}:parameter${name}"])}
    }
  ]
}
