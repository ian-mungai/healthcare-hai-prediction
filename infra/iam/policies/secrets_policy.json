{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadProjectSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": ${jsonencode([for name in SECRET_NAMES : "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:${name}-??????"])}
    },
    {
      "Sid": "ManageProjectSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:CreateSecret",
        "secretsmanager:PutSecretValue"
      ],
      "Resource": ${jsonencode([for name in MANAGED_SECRET_NAMES : "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:${name}-??????"])}
    }
  ]
}
