{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadStageInputsAndResults",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": [
        "arn:aws:s3:::${DATA_BUCKET_NAME}/lakehouse/run_stage/*/inputs/*",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/lakehouse/run_stage/*/tries/*"
      ]
    },
    {
      "Sid": "OwnGrant",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/lakehouse/run_stage/*/grants/${TASK_USER_ID}.json"
    }
  ]
}
