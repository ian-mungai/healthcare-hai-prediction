{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PullTrainingImages",
      "Effect": "Allow",
      "Action": ["ecr:BatchCheckLayerAvailability", "ecr:GetDownloadUrlForLayer", "ecr:BatchGetImage"],
      "Resource": [
        "arn:aws:ecr:${AWS_REGION}:${AWS_ACCOUNT_ID}:repository/${PROJECT_NAME}_training_${ENVIRONMENT}",
        "arn:aws:ecr:${AWS_REGION}:${AWS_ACCOUNT_ID}:repository/${PROJECT_NAME}_feature_store_${ENVIRONMENT}"
      ]
    }
  ]
}
