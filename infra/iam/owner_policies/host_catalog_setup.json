{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SetUpAwsPolarisPairs",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:PutParameter"],
      "Resource": ${PAIR_ARNS}
    },
    {
      "Sid": "HoldHostLaunches",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:PutParameter", "ssm:DeleteParameter"],
      "Resource": "${HOLD_ARN}"
    },
    {
      "Sid": "DenyHoldOverwrite",
      "Effect": "Deny",
      "Action": "ssm:PutParameter",
      "Resource": "${HOLD_ARN}",
      "Condition": { "StringEqualsIgnoreCase": { "ssm:Overwrite": "true" } }
    },
    {
      "Sid": "ReadAndWriteOwnRecords",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "${RECORDS_ARN}/*"
    },
    {
      "Sid": "TellAbsentRecordsFromDeniedOnes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "${BUCKET_ARN}",
      "Condition": { "StringLike": { "s3:prefix": ["${RECORD_SCOPE}*"] } }
    },
    {
      "Sid": "DenyApprovalCreateWithoutCondition",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "${RECORDS_ARN}/approvals/*",
      "Condition": { "StringNotEquals": { "s3:if-none-match": "*" } }
    },
    {
      "Sid": "DenyLockWriteWithoutCondition",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "${RECORDS_ARN}/locks/*",
      "Condition": { "Null": { "s3:if-none-match": "true", "s3:if-match": "true" } }
    },
    {
      "Sid": "DenyApprovalAndLockDelete",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": ["${RECORDS_ARN}/approvals/*", "${RECORDS_ARN}/locks/*"]
    },
    {
      "Sid": "ReadCatalogBackups",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": ${SNAPSHOT_ARNS}
    },
    {
      "Sid": "ListCatalogBackupFolders",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "${BUCKET_ARN}",
      "Condition": { "StringLike": { "s3:prefix": ${SNAPSHOT_SCOPES} } }
    },
    {
      "Sid": "ListProjectTasks",
      "Effect": "Allow",
      "Action": "ecs:ListTasks",
      "Resource": "*",
      "Condition": { "ArnEquals": { "ecs:cluster": "${CLUSTER_ARN}" } }
    },
    {
      "Sid": "DescribeProjectTasks",
      "Effect": "Allow",
      "Action": "ecs:DescribeTasks",
      "Resource": "${TASK_ARN}"
    }
  ]
}
