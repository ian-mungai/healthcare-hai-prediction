{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteLaunchRecordsOnce",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/${RECORD_PREFIX}*",
      "Condition": { "StringEquals": { "s3:if-none-match": "*" } }
    },
    {
      "Sid": "ReplaceDecisionRecords",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/${RECORD_PREFIX}*/decision.json",
      "Condition": { "Null": { "s3:if-match": "false" } }
    },
    {
      "Sid": "ReadLaunchRecords",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/${RECORD_PREFIX}*"
    },
    {
      "Sid": "ListLaunchRecords",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}",
      "Condition": { "StringLike": { "s3:prefix": ["${RECORD_PREFIX}*"] } }
    }
  ]
}
