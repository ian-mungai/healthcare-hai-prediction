{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreatePromotionReceipts",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/promote/*",
      "Condition": { "StringEquals": { "s3:if-none-match": "*" } }
    },
    {
      "Sid": "ReadPromotionReceipts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/promote/*"
    },
    {
      "Sid": "ListPromotionRecords",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}",
      "Condition": { "StringLike": { "s3:prefix": ["promote/*"] } }
    }
  ]
}
