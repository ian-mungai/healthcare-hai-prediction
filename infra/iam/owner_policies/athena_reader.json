{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "QueryThroughTheMirrorWorkgroup",
      "Effect": "Allow",
      "Action": ["athena:StartQueryExecution", "athena:StopQueryExecution", "athena:GetQueryExecution", "athena:GetQueryResults", "athena:GetWorkGroup"],
      "Resource": ["${WORKGROUP_ARN}"]
    },
    {
      "Sid": "ReadMirrorRegistrations",
      "Effect": "Allow",
      "Action": ["glue:GetDatabase", "glue:GetTable"],
      "Resource": ${GLUE_ARNS}
    },
    {
      "Sid": "ReadListedTableFolders",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ${TABLE_OBJECT_ARNS}
    },
    {
      "Sid": "ListListedTableFoldersAndResults",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["${BUCKET_ARN}"],
      "Condition": {"StringLike": {"s3:prefix": ${LIST_PREFIXES}}}
    },
    {
      "Sid": "LocateBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucketMultipartUploads"],
      "Resource": ["${BUCKET_ARN}"]
    },
    {
      "Sid": "WriteQueryResults",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": ["${RESULTS_OBJECT_ARN}"]
    }
  ]
}
