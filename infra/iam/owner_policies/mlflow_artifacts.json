{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteMlflowArtifacts",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/mlflow/*"
    },
    {
      "Sid": "ListMlflowPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["mlflow/*"]
        }
      }
    }
  ]
}
