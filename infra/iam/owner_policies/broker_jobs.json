{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunNamedJobFamilies",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": ${TASK_DEFINITION_ARNS},
      "Condition": {
        "ArnEquals": { "ecs:cluster": "${CLUSTER_ARN}" },
        "StringEquals": { "aws:RequestTag/Project": "${PROJECT_TAG}", "aws:RequestTag/HaiJob": ${FAMILIES} },
        "ForAllValues:StringEquals": { "aws:TagKeys": ["Project", "HaiJob"] }
      }
    },
    {
      "Sid": "TagTasksItStarts",
      "Effect": "Allow",
      "Action": "ecs:TagResource",
      "Resource": "${TASK_ARN_PATTERN}",
      "Condition": { "StringEquals": { "ecs:CreateAction": "RunTask" } }
    },
    {
      "Sid": "StopAndDescribeNamedJobTasks",
      "Effect": "Allow",
      "Action": ["ecs:StopTask", "ecs:DescribeTasks"],
      "Resource": "${TASK_ARN_PATTERN}",
      "Condition": { "StringEquals": { "aws:ResourceTag/HaiJob": ${FAMILIES} } }
    },
    {
      "Sid": "ListClusterTasks",
      "Effect": "Allow",
      "Action": "ecs:ListTasks",
      "Resource": "*",
      "Condition": { "ArnEquals": { "ecs:cluster": "${CLUSTER_ARN}" } }
    },
    {
      "Sid": "PassNamedJobRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": ${ROLE_ARNS},
      "Condition": { "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" } }
    },
    {
      "Sid": "ReadRunCodeDigest",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/lakehouse/run_stage/*/inputs/code.sha256"
    },
    {
      "Sid": "ReadJobLogs",
      "Effect": "Allow",
      "Action": "logs:GetLogEvents",
      "Resource": "arn:aws:logs:${AWS_REGION}:${AWS_ACCOUNT_ID}:log-group:${LOG_GROUP_NAME}:log-stream:*"
    },
    {
      "Sid": "ReadSignedPublishRecord",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:${AWS_REGION}:${AWS_ACCOUNT_ID}:parameter${SIGNED_PARAMETER_NAME}"
    }
  ]
}
