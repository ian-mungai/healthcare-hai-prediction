{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateRawObjectsOnce",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "${BUCKET_ARN}/raw/*",
      "Condition": {"Null": {"s3:if-none-match": "false"}}
    },
    {
      "Sid": "ReadRawObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "${BUCKET_ARN}/raw/*"
    },
    {
      "Sid": "ReadStoredPayloadVersions",
      "Effect": "Allow",
      "Action": ["s3:GetObjectVersion"],
      "Resource": [
        "${BUCKET_ARN}/*/*/datasets/*",
        "${BUCKET_ARN}/*/*/references/*",
        "${BUCKET_ARN}/bronze_objects/sha256/*",
        "${BUCKET_ARN}/bronze_evidence/sha256/*"
      ]
    },
    {
      "Sid": "ReadStagedRunInputs",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "${BUCKET_ARN}/lakehouse/run_stage/*/inputs/code.tar.gz",
        "${BUCKET_ARN}/lakehouse/run_stage/*/inputs/publisher_inputs.tar.gz"
      ]
    },
    {
      "Sid": "ListRawVersions",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": "${BUCKET_ARN}",
      "Condition": {"StringLike": {"s3:prefix": ["raw/*"]}}
    }
  ]
}
