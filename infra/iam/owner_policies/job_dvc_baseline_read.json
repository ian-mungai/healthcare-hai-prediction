{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDvcObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/dvc/*"
    },
    {
      "Sid": "ListDvcPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["dvc/*"]
        }
      }
    }
  ]
}
