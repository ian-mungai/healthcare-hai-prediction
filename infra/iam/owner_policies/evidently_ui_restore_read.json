{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDriftDemoObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/drift_demo/*"
    },
    {
      "Sid": "ListDriftDemoPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}",
      "Condition": {
        "StringLike": { "s3:prefix": ["drift_demo/*"] }
      }
    }
  ]
}
