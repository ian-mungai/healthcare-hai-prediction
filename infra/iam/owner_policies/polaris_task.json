{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageLakehouseTables",
      "Effect": "Allow",
      "Action": ["s3:AbortMultipartUpload", "s3:DeleteObject", "s3:GetObject", "s3:ListMultipartUploadParts", "s3:PutObject"],
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/lakehouse/*"
    },
    {
      "Sid": "ListLakehouseFolder",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}",
      "Condition": {"StringLike": {"s3:prefix": ["lakehouse/", "lakehouse/*"]}}
    }
  ]
}
