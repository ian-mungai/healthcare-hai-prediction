{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BronzeTableObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": ${TABLE_OBJECT_ARNS}
    },
    {
      "Sid": "ListBronzeTablePrefixes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "${BUCKET_ARN}",
      "Condition": {"StringLike": {"s3:prefix": ${TABLE_LIST_PREFIXES}}}
    },
    {
      "Sid": "SourceObjectVersionsOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObjectVersion"],
      "Resource": ${SOURCE_OBJECT_ARNS}
    },
    {
      "Sid": "ListSourceVersionsOnly",
      "Effect": "Allow",
      "Action": ["s3:ListBucketVersions"],
      "Resource": "${BUCKET_ARN}",
      "Condition": {"StringLike": {"s3:prefix": ${SOURCE_LIST_PREFIXES}}}
    }
  ]
}
