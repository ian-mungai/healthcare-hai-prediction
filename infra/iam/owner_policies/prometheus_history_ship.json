{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreatePrometheusBlocks",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/prometheus/blocks/*",
      "Condition": { "StringEquals": { "s3:if-none-match": "*" } }
    },
    {
      "Sid": "ListPrometheusBlocks",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}",
      "Condition": { "StringLike": { "s3:prefix": ["prometheus/blocks/*"] } }
    }
  ]
}
