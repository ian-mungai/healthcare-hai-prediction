{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateResearchRecords",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/research/*",
      "Condition": { "StringEquals": { "s3:if-none-match": "*" } }
    },
    {
      "Sid": "ReadResearchRecords",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/research/*"
    },
    {
      "Sid": "ListResearchRecords",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}",
      "Condition": { "StringLike": { "s3:prefix": ["research/*"] } }
    }
  ]
}
