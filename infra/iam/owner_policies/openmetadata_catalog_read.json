{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDbtArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/metadata/dbt/*"
    },
    {
      "Sid": "ReadChainRecords",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::${DATA_BUCKET_NAME}/lakehouse/layer_runs/features/*/gold_pins.json",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/lakehouse/layer_runs/gold/*/silver_pins.json",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/lakehouse/launch_records/*/silver/claim.json",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/lakehouse/bronze_runs/*/check.json",
        "arn:aws:s3:::${DATA_BUCKET_NAME}/raw/ingestion_units/*"
      ]
    },
    {
      "Sid": "ListDbtArtifacts",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["metadata/dbt/", "metadata/dbt/*"]
        }
      }
    },
    {
      "Sid": "ListAcquisitionRecords",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["raw/ingestion_units/", "raw/ingestion_units/*"]
        }
      }
    },
    {
      "Sid": "NoWrites",
      "Effect": "Deny",
      "Action": ["s3:PutObject", "s3:DeleteObject", "s3:DeleteObjectVersion", "s3:PutObjectAcl", "s3:PutObjectTagging", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/*"
    }
  ]
}
