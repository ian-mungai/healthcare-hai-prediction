{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FeastRegistryObject",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ${REGISTRY_OBJECT_ARNS}
    },
    {
      "Sid": "RedisPasswordParameter",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter"],
      "Resource": ${REDIS_PARAMETER_ARNS}
    },
    {
      "Sid": "ReadProductionRecords",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ${PRODUCTION_OBJECT_ARNS}
    },
    {
      "Sid": "ListProductionRecords",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "${BUCKET_ARN}",
      "Condition": { "StringLike": { "s3:prefix": ${PRODUCTION_LIST_PREFIXES} } }
    },
    {
      "Sid": "ListPromotionLeases",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "${BUCKET_ARN}",
      "Condition": { "StringLike": { "s3:prefix": ${LEASE_LIST_PREFIXES} } }
    },
    {
      "Sid": "ReadFeaturesRunRecords",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ${RUN_RECORD_OBJECT_ARNS}
    },
    {
      "Sid": "ListFeaturesRunRecords",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "${BUCKET_ARN}",
      "Condition": { "StringLike": { "s3:prefix": ${RUN_RECORD_LIST_PREFIXES} } }
    }
  ]
}
