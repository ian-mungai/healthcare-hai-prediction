{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassReadJobRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_execution_${ENVIRONMENT}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_offline_task_${ENVIRONMENT}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_seal_task_${ENVIRONMENT}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_read_task_${ENVIRONMENT}"
      ],
      "Condition": {"StringEquals": {"iam:PassedToService": "ecs-tasks.amazonaws.com"}}
    },
    {
      "Sid": "AssumeTryOutputRole",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${PROJECT_NAME}_job_try_writer_${ENVIRONMENT}",
      "Condition": {"StringLike": {"sts:RoleSessionName": "hai_try_*"}}
    },
    {
      "Sid": "ReadStageVersions",
      "Effect": "Allow",
      "Action": "s3:GetObjectVersion",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}/lakehouse/run_stage/*"
    },
    {
      "Sid": "ReadAwsReaderPair",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:${AWS_REGION}:${AWS_ACCOUNT_ID}:parameter${AWS_POLARIS_READER_CLIENT_ID_NAME}",
        "arn:aws:ssm:${AWS_REGION}:${AWS_ACCOUNT_ID}:parameter${AWS_POLARIS_READER_CLIENT_SECRET_NAME}"
      ]
    }
  ]
}
