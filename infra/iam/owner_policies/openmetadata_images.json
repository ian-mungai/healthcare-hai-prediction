{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PullCatalogImages",
      "Effect": "Allow",
      "Action": ["ecr:BatchCheckLayerAvailability", "ecr:GetDownloadUrlForLayer", "ecr:BatchGetImage"],
      "Resource": [
        "arn:aws:ecr:${AWS_REGION}:${AWS_ACCOUNT_ID}:repository/${PROJECT_NAME}_openmetadata_server_${ENVIRONMENT}",
        "arn:aws:ecr:${AWS_REGION}:${AWS_ACCOUNT_ID}:repository/${PROJECT_NAME}_openmetadata_ingestion_${ENVIRONMENT}",
        "arn:aws:ecr:${AWS_REGION}:${AWS_ACCOUNT_ID}:repository/${PROJECT_NAME}_openmetadata_search_${ENVIRONMENT}",
        "arn:aws:ecr:${AWS_REGION}:${AWS_ACCOUNT_ID}:repository/${PROJECT_NAME}_openmetadata_database_${ENVIRONMENT}"
      ]
    }
  ]
}
