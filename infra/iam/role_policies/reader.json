{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTableFiles",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": ${jsonencode([for prefix in READ_PREFIXES : "arn:aws:s3:::${DATA_BUCKET_NAME}/${prefix}*"])}
    },
    {
      "Sid": "ListTablePrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}",
      "Condition": {
        "StringLike": {
          "s3:prefix": ${jsonencode(flatten([for prefix in READ_PREFIXES : [trimsuffix(prefix, "/"), "${prefix}*"]]))}
        }
      }
    },
    {
      "Sid": "LocateBucket",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::${DATA_BUCKET_NAME}"
    }
  ]
}
