# Secrets and local settings (.env.example documents the variables)
.env
.env.*
!.env.example
.bruin.yml

# Python environment, caches and coverage
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage*
htmlcov/

# Pinned quality-tool binaries installed by scripts/quality/install_tools.py
.tools/

# Agent and workspace files. Also in the global Git ignore; repeated here so fresh clones and CI stay safe.
.agent_handoff/
/.documentation_review.json
.enjoy/
.enjoy-logs/

# macOS
.DS_Store

# Data, run output and model artifacts: data lives in S3, never in Git
logs/
data/
artifacts/
mlruns/
*.pkl
*.joblib
*.parquet
*.csv
*.jsonl

# Data collection code, configuration and tests. Committed with full process documentation
# at the end of the data collection stage (user decision, Sep 26 2026).
/config/acquisition/
/scripts/acquisition/
/tests/test_source_registry.py

# Terraform: state and plans stay local; the .terraform.lock.hcl files are committed
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
*.tfvars
*.tfvars.json
.terraform.tfstate.lock.info
crash.log
crash.*.log
