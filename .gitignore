# Secrets and local settings (.env.example documents the variables)
.env
.env.*
!.env.example
.bruin.yml

# Python environment, caches and coverage
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage*
htmlcov/

# Pinned quality-tool binaries installed by scripts/quality/install_tools.py
.tools/

# Agent and workspace files. Also in the global Git ignore; repeated here so fresh clones and CI stay safe.
.agent_handoff/
/.documentation_review.json
.enjoy/
.enjoy-logs/
# The issue register is local-only and never enters Git.
/docs/issue_register.md
# The project guide is local-only.
/docs/project_guide.md
# Plans (analysis, implementation and gap plans) stay local and are never committed.
/plans/

# macOS
.DS_Store

# Data, run output and model artifacts: data lives in S3, never in Git
logs/
data/
artifacts/
mlruns/
*.pkl
*.joblib
*.parquet
*.csv
# The reviewed dbt seeds are committed; repo_checks.py declares their folder.
!dbt/seeds/*.csv
*.jsonl

# Data collection code, configuration and tests are tracked so CI can run the acquisition checks;
# collected data stays under the ignored data/ folder.

# Terraform: state and plans stay local; the .terraform.lock.hcl files are committed
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
*.tfvars
*.tfvars.json
.terraform.tfstate.lock.info
crash.log
crash.*.log
# dbt build output from the SQLFluff dbt templater; runs in the container write to data/analytics/dbt/
/dbt/target/
# Receipts that Archify finalize writes beside the diagram HTML; the JSON source and HTML are committed.
/docs/architecture/architecture.*.json
