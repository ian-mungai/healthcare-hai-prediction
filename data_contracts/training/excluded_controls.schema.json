{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "controls": {
      "items": {
        "pattern": "^[A-Z][0-9]{3}(?:\\.[A-Za-z0-9_]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "const": 1
    }
  },
  "required": [
    "schema",
    "controls"
  ],
  "title": "Excluded controls",
  "type": "object"
}
