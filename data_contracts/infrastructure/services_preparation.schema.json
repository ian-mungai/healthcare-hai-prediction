{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed services preparation inputs",
  "description": "Nonsecret inputs of the services stack that the platform outputs and the committed defaults do not supply (the MLflow, broker, model API, page and monitoring switches with their roles and addresses), bound to a reviewed byte digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "root",
    "variables"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "root": {
      "const": "services"
    },
    "variables": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mlflow_enabled": {
          "type": "boolean"
        },
        "mlflow_task_role_arn": {
          "type": "string",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_mlflow_task_(dev|prod)$"
        },
        "mlflow_host_ip": {
          "type": "string",
          "pattern": "^(10\\.[0-9]{1,3}|172\\.(1[6-9]|2[0-9]|3[01])|192\\.168)\\.[0-9]{1,3}\\.[0-9]{1,3}$"
        },
        "mlflow_artifact_bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
        },
        "marquez_enabled": {
          "type": "boolean"
        },
        "model_api_enabled": {
          "type": "boolean"
        },
        "streamlit_enabled": {
          "type": "boolean"
        },
        "broker_enabled": {
          "type": "boolean"
        },
        "monitoring_enabled": {
          "type": "boolean"
        },
        "model_api_task_role_arn": {
          "type": "string",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:model_api_task)_(dev|prod)$"
        },
        "streamlit_task_role_arn": {
          "type": "string",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:streamlit_task)_(dev|prod)$"
        },
        "broker_task_role_arn": {
          "type": "string",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:broker_task)_(dev|prod)$"
        },
        "model_api_hai_types": {
          "type": "string",
          "pattern": "^HAI_[1-6](,HAI_[1-6]){0,5}$"
        },
        "streamlit_hai_types": {
          "type": "string",
          "pattern": "^HAI_[1-6](,HAI_[1-6]){0,5}$"
        },
        "model_api_manifest_uri": {
          "type": "string",
          "pattern": "^s3://[a-z0-9][a-z0-9.-]{2,62}/[A-Za-z0-9_./-]+$"
        },
        "model_api_registry_uri": {
          "type": "string",
          "pattern": "^s3://[a-z0-9][a-z0-9.-]{2,62}/[A-Za-z0-9_./-]+$"
        },
        "model_api_mlflow_uri": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]{4,5}$"
        },
        "model_api_rate_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000
        },
        "model_api_burst": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "prometheus_retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "prometheus_retention_size_mb": {
          "type": "integer",
          "minimum": 256,
          "maximum": 16384
        },
        "monitoring_memory_mib": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prometheus",
            "grafana",
            "statsd_exporter"
          ],
          "properties": {
            "prometheus": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "limit",
                "reservation"
              ],
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 32
                },
                "reservation": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "grafana": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "limit",
                "reservation"
              ],
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 32
                },
                "reservation": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "statsd_exporter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "limit",
                "reservation"
              ],
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 32
                },
                "reservation": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "broker_jobs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subnet_id",
            "security_group_ids",
            "log_group_name",
            "bucket_name",
            "host_ip",
            "families"
          ],
          "properties": {
            "subnet_id": {
              "type": "string",
              "pattern": "^subnet-[0-9a-z]{1,17}$"
            },
            "security_group_ids": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lakehouse": {
                  "type": "string",
                  "pattern": "^sg-[0-9a-z]{8,17}$"
                },
                "training": {
                  "type": "string",
                  "pattern": "^sg-[0-9a-z]{8,17}$"
                }
              }
            },
            "log_group_name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]+_jobs_(dev|prod)$"
            },
            "bucket_name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
            },
            "host_ip": {
              "type": "string",
              "pattern": "^(10\\.[0-9]{1,3}|172\\.(1[6-9]|2[0-9]|3[01])|192\\.168)\\.[0-9]{1,3}\\.[0-9]{1,3}$"
            },
            "families": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "train",
                  "bronze",
                  "silver",
                  "gold",
                  "features",
                  "drift",
                  "promote",
                  "serve",
                  "metadata"
                ]
              }
            }
          }
        }
      }
    }
  }
}
