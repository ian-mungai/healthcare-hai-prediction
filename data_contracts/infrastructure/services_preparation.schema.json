{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Services one-off overrides",
  "description": "Nonsecret one-off overrides of the committed services defaults and rendered inputs, bound to a byte digest, for the services Terraform root. A file of them is Git-ignored and never reaches main.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "root",
    "variables"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "root": {
      "const": "services"
    },
    "variables": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mlflow_enabled": {
          "type": "boolean"
        },
        "airflow_lineage_http_enabled": {
          "type": "boolean"
        },
        "airflow_lineage_url": {
          "type": "string",
          "pattern": "^http://(127\\.0\\.0\\.1|10(\\.[0-9]{1,3}){3}|172\\.(1[6-9]|2[0-9]|3[01])(\\.[0-9]{1,3}){2}|192\\.168(\\.[0-9]{1,3}){2}):8585$"
        },
        "mlflow_task_role_arn": {
          "type": "string",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_mlflow_task_(dev|prod)$"
        },
        "mlflow_artifact_bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
        },
        "marquez_enabled": {
          "type": "boolean"
        },
        "openmetadata_persistent_enabled": {
          "type": "boolean"
        },
        "openmetadata_task_role_arn": {
          "type": "string",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:openmetadata_host_task)_(dev|prod)$"
        },
        "code_fetch_task_role_arn": {
          "type": "string",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:host_code_fetch_task)_(dev|prod)$"
        },
        "code_bucket_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$"
        },
        "model_api_enabled": {
          "type": "boolean"
        },
        "streamlit_enabled": {
          "type": "boolean"
        },
        "monitoring_enabled": {
          "type": "boolean"
        },
        "model_api_task_role_arn": {
          "type": "string",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:model_api_task)_(dev|prod)$"
        },
        "streamlit_task_role_arn": {
          "type": "string",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:streamlit_task)_(dev|prod)$"
        },
        "serving_execution_role_arn": {
          "type": "string",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:serving_execution)_(dev|prod)$"
        },
        "airflow_launch_task_role_arn": {
          "type": "string",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:airflow_launch_task)_(dev|prod)$"
        },
        "airflow_launch_bucket_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
        },
        "model_api_hai_types": {
          "type": "string",
          "pattern": "^HAI_[1-6](,HAI_[1-6]){0,5}$"
        },
        "streamlit_hai_types": {
          "type": "string",
          "pattern": "^HAI_[1-6](,HAI_[1-6]){0,5}$"
        },
        "model_api_manifest_uri": {
          "type": "string",
          "pattern": "^s3://[a-z0-9][a-z0-9.-]{2,62}/[A-Za-z0-9_./-]+$"
        },
        "model_api_registry_uri": {
          "type": "string",
          "pattern": "^s3://[a-z0-9][a-z0-9.-]{2,62}/[A-Za-z0-9_./-]+$"
        },
        "model_api_mlflow_uri": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]{4,5}$"
        },
        "model_api_rate_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000
        },
        "model_api_burst": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "prometheus_retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "prometheus_retention_size_mb": {
          "type": "integer",
          "minimum": 256,
          "maximum": 16384
        },
        "monitoring_memory_mib": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prometheus",
            "grafana",
            "statsd_exporter"
          ],
          "properties": {
            "prometheus": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "limit",
                "reservation"
              ],
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 32
                },
                "reservation": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "grafana": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "limit",
                "reservation"
              ],
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 32
                },
                "reservation": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "statsd_exporter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "limit",
                "reservation"
              ],
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 32
                },
                "reservation": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "host_usable_memory_mib": {
          "type": "integer",
          "minimum": 1
        },
        "host_job_cap_mib": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 32767
        }
      }
    }
  }
}
