{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jobs one-off overrides",
  "description": "Nonsecret one-off overrides of the committed jobs defaults and rendered inputs, bound to a byte digest, for the jobs Terraform root. A file of them is Git-ignored and never reaches main.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "root",
    "variables"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "root": {
      "enum": [
        "jobs"
      ]
    },
    "variables": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "root": {
          "const": "jobs"
        },
        "variables": {
          "$ref": "#/$defs/read"
        }
      }
    }
  ],
  "$defs": {
    "read": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "analytics": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9_]+@sha256:[a-f0-9]{64}$"
            },
            "quality": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9_]+@sha256:[a-f0-9]{64}$"
            },
            "spark": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9_]+@sha256:[a-f0-9]{64}$"
            }
          }
        },
        "job_role_arns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "execution": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+$"
            },
            "publisher_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_job_publisher_task_(dev|prod)$"
            },
            "write_silver_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_job_write_silver_task_(dev|prod)$"
            },
            "write_gold_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_job_write_gold_task_(dev|prod)$"
            },
            "write_features_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_job_write_features_task_(dev|prod)$"
            },
            "write_bronze_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_job_write_bronze_task_(dev|prod)$"
            }
          }
        },
        "log_group_name": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]+_jobs_(dev|prod)$"
        },
        "aws_polaris_reader_client_id_name": {
          "type": "string",
          "pattern": "^/[a-z][a-z0-9_]+/aws_polaris_reader_client_id$"
        },
        "aws_polaris_reader_client_secret_name": {
          "type": "string",
          "pattern": "^/[a-z][a-z0-9_]+/aws_polaris_reader_client_secret$"
        },
        "writer_parameter_names": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "write_e2e_task": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_e2e_client_id$"
                },
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_e2e_client_secret$"
                }
              ],
              "items": false
            },
            "write_silver_task": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_silver_client_id$"
                },
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_silver_client_secret$"
                }
              ],
              "items": false
            },
            "write_gold_task": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_gold_client_id$"
                },
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_gold_client_secret$"
                }
              ],
              "items": false
            },
            "write_features_task": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_features_client_id$"
                },
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_features_client_secret$"
                }
              ],
              "items": false
            },
            "write_bronze_task": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_bronze_client_id$"
                },
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_bronze_client_secret$"
                }
              ],
              "items": false
            }
          }
        },
        "train_enabled": {
          "type": "boolean"
        },
        "train_images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "training": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z][a-z0-9_]+_training_(dev|prod)@sha256:[a-f0-9]{64}$"
            },
            "feature_store": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z][a-z0-9_]+_feature_store_(dev|prod)@sha256:[a-f0-9]{64}$"
            }
          }
        },
        "train_roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "execution": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_job_execution_(dev|prod)$"
            },
            "train_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_job_train_task_(dev|prod)$"
            }
          }
        },
        "mlflow_admin_password_name": {
          "type": "string",
          "pattern": "^/[a-z][a-z0-9_]+/mlflow_admin_password$"
        },
        "layer_jobs_enabled": {
          "type": "boolean"
        },
        "layer_jobs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "silver",
              "gold",
              "features"
            ]
          }
        },
        "drift_enabled": {
          "type": "boolean"
        },
        "drift_images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "training": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z][a-z0-9_]+_training_(dev|prod)@sha256:[a-f0-9]{64}$"
            },
            "feature_store": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z][a-z0-9_]+_feature_store_(dev|prod)@sha256:[a-f0-9]{64}$"
            },
            "drift": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z][a-z0-9_]+_drift_(dev|prod)@sha256:[a-f0-9]{64}$"
            }
          }
        },
        "drift_roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "execution": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:job_execution)_(dev|prod)$"
            },
            "drift_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:job_drift_task)_(dev|prod)$"
            }
          }
        },
        "bronze_job_enabled": {
          "type": "boolean"
        },
        "publisher_job_enabled": {
          "type": "boolean"
        },
        "publisher_keys_enabled": {
          "type": "boolean"
        },
        "promote_enabled": {
          "type": "boolean"
        },
        "serve_enabled": {
          "type": "boolean"
        },
        "serve_roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serve_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:job_serve_task)_(dev|prod)$"
            }
          }
        },
        "serve_manifest_prefix": {
          "type": "string",
          "pattern": "^(?!lakehouse/)[A-Za-z0-9_][A-Za-z0-9_./-]{0,200}[A-Za-z0-9_]$"
        },
        "openmetadata_images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ingestion": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z][a-z0-9_]+_openmetadata_ingestion_(dev|prod)@sha256:[a-f0-9]{64}$"
            }
          }
        },
        "openmetadata_roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "execution": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:job_execution)_(dev|prod)$"
            },
            "openmetadata_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:job_openmetadata_task)_(dev|prod)$"
            }
          }
        },
        "host_jobs_enabled": {
          "type": "boolean"
        },
        "host_jobs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "bronze",
              "drift",
              "features",
              "features_m1",
              "features_m2",
              "features_m3",
              "features_m4",
              "features_m5",
              "features_m6",
              "gold",
              "metadata",
              "promote",
              "serve",
              "silver",
              "train"
            ]
          }
        },
        "host_scratch_root": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)(?!.*//)/data/job_scratch(/[A-Za-z0-9_]([A-Za-z0-9_./-]*[A-Za-z0-9_])?)?$"
        },
        "host_repo_path": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?!.*\\.\\.)/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "openmetadata_ingestion_token_name": {
          "type": "string",
          "pattern": "^/[a-z][a-z0-9_]+/openmetadata_bot_ingestion$"
        },
        "bronze_read_environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "HAI_READ_RAW_ROOT": {
              "const": "true"
            }
          }
        }
      }
    }
  }
}
