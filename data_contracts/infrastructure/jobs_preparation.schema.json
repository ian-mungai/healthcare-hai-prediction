{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed jobs preparation inputs",
  "description": "Nonsecret prepared inputs bound to a reviewed byte digest and a single disabled-by-default Terraform root.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "root",
    "variables"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "root": {
      "enum": [
        "jobs",
        "identity_probe"
      ]
    },
    "variables": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "root": {
          "const": "jobs"
        },
        "variables": {
          "$ref": "#/$defs/read"
        }
      }
    },
    {
      "properties": {
        "root": {
          "const": "identity_probe"
        },
        "variables": {
          "$ref": "#/$defs/probe"
        }
      }
    }
  ],
  "$defs": {
    "read": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobs_enabled": {
          "type": "boolean"
        },
        "enabled_definitions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "analytics_offline",
              "quality_offline",
              "seal",
              "analytics_read",
              "spark_read",
              "spark_write_e2e",
              "spark_write_silver",
              "spark_write_gold",
              "spark_write_features",
              "spark_write_bronze"
            ]
          }
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "analytics": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9_]+@sha256:[a-f0-9]{64}$"
            },
            "quality": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9_]+@sha256:[a-f0-9]{64}$"
            },
            "spark": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9_]+@sha256:[a-f0-9]{64}$"
            }
          }
        },
        "job_role_arns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "execution": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+$"
            },
            "offline_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+$"
            },
            "seal_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+$"
            },
            "read_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+$"
            },
            "write_e2e_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_job_write_e2e_task_(dev|prod)$"
            },
            "write_silver_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_job_write_silver_task_(dev|prod)$"
            },
            "write_gold_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_job_write_gold_task_(dev|prod)$"
            },
            "write_features_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_job_write_features_task_(dev|prod)$"
            },
            "write_bronze_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_job_write_bronze_task_(dev|prod)$"
            }
          }
        },
        "task_resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "analytics_offline": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral_storage_gib"
              ],
              "properties": {
                "cpu": {
                  "type": "integer",
                  "enum": [
                    1024,
                    2048,
                    4096,
                    8192,
                    16384
                  ]
                },
                "memory": {
                  "type": "integer",
                  "minimum": 2048,
                  "maximum": 122880
                },
                "ephemeral_storage_gib": {
                  "type": "integer",
                  "minimum": 20,
                  "maximum": 200
                }
              }
            },
            "quality_offline": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral_storage_gib"
              ],
              "properties": {
                "cpu": {
                  "type": "integer",
                  "enum": [
                    1024,
                    2048,
                    4096,
                    8192,
                    16384
                  ]
                },
                "memory": {
                  "type": "integer",
                  "minimum": 2048,
                  "maximum": 122880
                },
                "ephemeral_storage_gib": {
                  "type": "integer",
                  "minimum": 20,
                  "maximum": 200
                }
              }
            },
            "seal": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral_storage_gib"
              ],
              "properties": {
                "cpu": {
                  "type": "integer",
                  "enum": [
                    1024,
                    2048,
                    4096,
                    8192,
                    16384
                  ]
                },
                "memory": {
                  "type": "integer",
                  "minimum": 2048,
                  "maximum": 122880
                },
                "ephemeral_storage_gib": {
                  "type": "integer",
                  "minimum": 20,
                  "maximum": 200
                }
              }
            },
            "analytics_read": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral_storage_gib"
              ],
              "properties": {
                "cpu": {
                  "type": "integer",
                  "enum": [
                    1024,
                    2048,
                    4096,
                    8192,
                    16384
                  ]
                },
                "memory": {
                  "type": "integer",
                  "minimum": 2048,
                  "maximum": 122880
                },
                "ephemeral_storage_gib": {
                  "type": "integer",
                  "minimum": 20,
                  "maximum": 200
                }
              }
            },
            "spark_read": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral_storage_gib"
              ],
              "properties": {
                "cpu": {
                  "type": "integer",
                  "enum": [
                    1024,
                    2048,
                    4096,
                    8192,
                    16384
                  ]
                },
                "memory": {
                  "type": "integer",
                  "minimum": 2048,
                  "maximum": 122880
                },
                "ephemeral_storage_gib": {
                  "type": "integer",
                  "minimum": 20,
                  "maximum": 200
                }
              }
            },
            "spark_write_e2e": {
              "$ref": "#/$defs/writer_task_resources"
            },
            "spark_write_silver": {
              "$ref": "#/$defs/writer_task_resources"
            },
            "spark_write_gold": {
              "$ref": "#/$defs/writer_task_resources"
            },
            "spark_write_features": {
              "$ref": "#/$defs/writer_task_resources"
            },
            "spark_write_bronze": {
              "$ref": "#/$defs/writer_task_resources"
            }
          }
        },
        "cloud_limits": {
          "enum": [
            null,
            {
              "max_tasks": 3,
              "max_vcpu": 16,
              "max_memory_gib": 120
            }
          ]
        },
        "log_group_name": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]+_jobs_(dev|prod)$"
        },
        "aws_polaris_reader_client_id_name": {
          "type": "string",
          "pattern": "^/[a-z][a-z0-9_]+/aws_polaris_reader_client_id$"
        },
        "aws_polaris_reader_client_secret_name": {
          "type": "string",
          "pattern": "^/[a-z][a-z0-9_]+/aws_polaris_reader_client_secret$"
        },
        "writer_parameter_names": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "write_e2e_task": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_e2e_client_id$"
                },
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_e2e_client_secret$"
                }
              ],
              "items": false
            },
            "write_silver_task": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_silver_client_id$"
                },
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_silver_client_secret$"
                }
              ],
              "items": false
            },
            "write_gold_task": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_gold_client_id$"
                },
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_gold_client_secret$"
                }
              ],
              "items": false
            },
            "write_features_task": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_features_client_id$"
                },
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_features_client_secret$"
                }
              ],
              "items": false
            },
            "write_bronze_task": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_bronze_client_id$"
                },
                {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^/(?!(?:[aA][wW][sS]|[sS][sS][mM]))(?:[A-Za-z0-9_]+/){0,14}aws_polaris_bronze_client_secret$"
                }
              ],
              "items": false
            }
          }
        },
        "train_enabled": {
          "type": "boolean"
        },
        "train_images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "training": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z][a-z0-9_]+_training_(dev|prod)@sha256:[a-f0-9]{64}$"
            },
            "feature_store": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z][a-z0-9_]+_feature_store_(dev|prod)@sha256:[a-f0-9]{64}$"
            }
          }
        },
        "train_roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "execution": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_job_execution_(dev|prod)$"
            },
            "train_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_job_train_task_(dev|prod)$"
            }
          }
        },
        "train_resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory",
            "ephemeral_storage_gib"
          ],
          "properties": {
            "cpu": {
              "enum": [
                1024,
                2048,
                4096,
                8192,
                16384
              ]
            },
            "memory": {
              "type": "integer",
              "minimum": 2048,
              "maximum": 122880
            },
            "ephemeral_storage_gib": {
              "type": "integer",
              "minimum": 20,
              "maximum": 200
            }
          }
        },
        "mlflow_admin_password_name": {
          "type": "string",
          "pattern": "^/[a-z][a-z0-9_]+/mlflow_admin_password$"
        },
        "layer_jobs_enabled": {
          "type": "boolean"
        },
        "layer_jobs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "silver",
              "gold",
              "features"
            ]
          }
        },
        "layer_resources": {
          "$ref": "#/$defs/job_resources"
        },
        "layer_feast_redis_host": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$"
        },
        "drift_enabled": {
          "type": "boolean"
        },
        "drift_images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "training": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z][a-z0-9_]+_training_(dev|prod)@sha256:[a-f0-9]{64}$"
            },
            "feature_store": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z][a-z0-9_]+_feature_store_(dev|prod)@sha256:[a-f0-9]{64}$"
            },
            "drift": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z][a-z0-9_]+_drift_(dev|prod)@sha256:[a-f0-9]{64}$"
            }
          }
        },
        "drift_roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "execution": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:job_execution)_(dev|prod)$"
            },
            "drift_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:job_drift_task)_(dev|prod)$"
            }
          }
        },
        "drift_resources": {
          "$ref": "#/$defs/job_resources"
        },
        "bronze_job_enabled": {
          "type": "boolean"
        },
        "bronze_resources": {
          "$ref": "#/$defs/job_resources"
        },
        "promote_enabled": {
          "type": "boolean"
        },
        "promote_resources": {
          "$ref": "#/$defs/job_resources"
        },
        "serve_enabled": {
          "type": "boolean"
        },
        "serve_roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serve_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:job_serve_task)_(dev|prod)$"
            }
          }
        },
        "serve_manifest_prefix": {
          "type": "string",
          "pattern": "^(?!lakehouse/)[A-Za-z0-9_][A-Za-z0-9_./-]{0,200}[A-Za-z0-9_]$"
        },
        "serve_resources": {
          "$ref": "#/$defs/job_resources"
        },
        "openmetadata_enabled": {
          "type": "boolean"
        },
        "openmetadata_images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z][a-z0-9_]+_openmetadata_server_(dev|prod)@sha256:[a-f0-9]{64}$"
            },
            "ingestion": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z][a-z0-9_]+_openmetadata_ingestion_(dev|prod)@sha256:[a-f0-9]{64}$"
            },
            "search": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z][a-z0-9_]+_openmetadata_search_(dev|prod)@sha256:[a-f0-9]{64}$"
            },
            "database": {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z][a-z0-9_]+_openmetadata_database_(dev|prod)@sha256:[a-f0-9]{64}$"
            }
          }
        },
        "openmetadata_roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "execution": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:job_execution)_(dev|prod)$"
            },
            "openmetadata_task": {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+_(?:job_openmetadata_task)_(dev|prod)$"
            }
          }
        },
        "openmetadata_resources": {
          "$ref": "#/$defs/job_resources"
        },
        "openmetadata_lifetime_seconds": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 14400
        },
        "openmetadata_cpu_architecture": {
          "enum": [
            "X86_64",
            "ARM64"
          ]
        },
        "openmetadata_marquez_url": {
          "type": "string",
          "pattern": "^$|^http://[0-9]{1,3}(\\.[0-9]{1,3}){3}:[0-9]{2,5}$"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probe_enabled": {
          "type": "boolean"
        },
        "seed_image": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9_]+@sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_role_arn": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_role_arn": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^arn:aws:iam::[0-9]{12}:role/[a-z][a-z0-9_]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_role_unique_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^AROA[A-Z0-9]{17}$"
        },
        "log_group_name": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]+_jobs_(dev|prod)$"
        },
        "foundation_network": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "subnet_ids",
            "security_group_ids"
          ],
          "properties": {
            "subnet_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^subnet-([a-f0-9]{8}|[a-f0-9]{17})$"
              }
            },
            "security_group_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^sg-([a-f0-9]{8}|[a-f0-9]{17})$"
              }
            }
          }
        }
      }
    },
    "writer_task_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory",
        "ephemeral_storage_gib"
      ],
      "properties": {
        "cpu": {
          "type": "integer",
          "enum": [
            1024,
            2048,
            4096,
            8192,
            16384
          ]
        },
        "memory": {
          "type": "integer",
          "minimum": 2048,
          "maximum": 122880
        },
        "ephemeral_storage_gib": {
          "type": "integer",
          "minimum": 20,
          "maximum": 200
        }
      }
    },
    "job_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory",
        "ephemeral_storage_gib"
      ],
      "properties": {
        "cpu": {
          "type": "integer",
          "enum": [
            1024,
            2048,
            4096,
            8192,
            16384
          ]
        },
        "memory": {
          "type": "integer",
          "minimum": 2048,
          "maximum": 122880
        },
        "ephemeral_storage_gib": {
          "type": "integer",
          "minimum": 20,
          "maximum": 200
        }
      }
    }
  }
}
