{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "skipped"
          }
        }
      },
      "then": {
        "properties": {
          "drift_share": {
            "type": "null"
          },
          "drifted_count": {
            "const": 0
          },
          "evidently_version": {
            "type": "null"
          },
          "feature_count": {
            "const": 0
          },
          "features": {
            "maxItems": 0
          },
          "skip_reason": {
            "type": "string"
          },
          "triggered": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "checked"
          }
        }
      },
      "then": {
        "properties": {
          "drift_share": {
            "type": "number"
          },
          "evidently_version": {
            "type": "string"
          },
          "feature_count": {
            "minimum": 1
          },
          "skip_reason": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "current": {
      "additionalProperties": false,
      "properties": {
        "matrix_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "rows": {
          "minimum": 0,
          "type": "integer"
        },
        "window_years": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "matrix_sha256",
        "rows",
        "window_years"
      ],
      "type": "object"
    },
    "drift_share": {
      "maximum": 1,
      "minimum": 0,
      "type": [
        "number",
        "null"
      ]
    },
    "drifted_count": {
      "minimum": 0,
      "type": "integer"
    },
    "evidently_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "feature_count": {
      "minimum": 0,
      "type": "integer"
    },
    "features": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "column_type": {
            "enum": [
              "numerical",
              "categorical"
            ]
          },
          "drifted": {
            "type": "boolean"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "test": {
            "minLength": 1,
            "type": "string"
          },
          "threshold": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "column_type",
          "test",
          "threshold",
          "score",
          "drifted"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "hai_type": {
      "pattern": "^HAI_[1-6]$",
      "type": "string"
    },
    "kind": {
      "const": "drift_record"
    },
    "population": {
      "enum": [
        "primary",
        "sensitivity"
      ]
    },
    "reference": {
      "additionalProperties": false,
      "properties": {
        "matrix_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "newest_window_year": {
          "type": "integer"
        },
        "rows": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "matrix_sha256",
        "newest_window_year",
        "rows"
      ],
      "type": "object"
    },
    "run_id": {
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "skip_reason": {
      "enum": [
        "no_new_window",
        "population_not_monitored",
        "too_few_current_rows",
        null
      ]
    },
    "status": {
      "enum": [
        "checked",
        "skipped"
      ]
    },
    "triggered": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "hai_type",
    "population",
    "status",
    "skip_reason",
    "config_sha256",
    "evidently_version",
    "reference",
    "current",
    "features",
    "feature_count",
    "drifted_count",
    "drift_share",
    "triggered"
  ],
  "type": "object"
}
