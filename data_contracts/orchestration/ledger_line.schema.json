                "real"
              ]
            },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            }
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "name",
              "snapshot"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "maxLength": 250,
                "pattern": "^(file|s3://[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]|iceberg://[A-Za-z0-9_.:-]+(/[A-Za-z0-9_.-]+)*)$(?![\\s\\S])"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?:[A-Za-z0-9_./:-]|\\{(?:run_id|mode|run_dir|build_file|checkout)\\})+$(?![\\s\\S])",
                "not": {
                  "pattern": "(^|/)(\\.\\.|secrets?|\\.env|[^/]*\\.(key|pem))(/|$)"
                }
              },
              "snapshot": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "const": "file_sha256"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "const": "iceberg_snapshot"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,18}$(?![\\s\\S])"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "const": "s3_object_version"
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024,
                        "not": {
