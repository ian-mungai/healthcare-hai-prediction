{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthcare-hai-prediction.invalid/orchestration/ledger_line.schema.json",
  "title": "Ledger line",
  "description": "One line of data/orchestration/ledger/<run_id>.jsonl. The broker appends a line and fsyncs the file before the action the line announces (Airflow plan section 7; failure modes 758 and 775). Order per submission: intent, then started (or adopted after a crash), then finished; failed_closed stops the submission for the owner.",
  "type": "object",
  "required": [
    "schema_version",
    "event",
    "at",
    "submission_id",
    "run_id",
    "template",
    "mode",
    "attempt"
  ],
  "properties": {
    "request_version": {
      "const": 2
    },
    "dag_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"
    },
    "dag_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+~=-]*$(?![\\s\\S])"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "snapshot_record": {
      "$ref": "#/$defs/snapshot_record"
    },
    "input_snapshot_record": {
      "$ref": "#/$defs/input_snapshot_record"
    },
    "input_pins": {
      "$ref": "#/$defs/input_snapshot_record/properties/inputs"
    },
    "schema_version": {
      "const": 1
    },
    "event": {
      "enum": [
        "intent",
        "started",
        "adopted",
        "finished",
        "failed_closed"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}:[a-z][a-z0-9_]{1,40}:(fixture|publish_fixture|real):[0-9]{1,2}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "template": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,40}$"
    },
    "mode": {
      "enum": [
        "fixture",
        "publish_fixture",
        "real"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "dbt_nodes": {
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,249}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/dataset"
      }
    },
    "dbt_lineage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://healthcare-hai-prediction.invalid/orchestration/dbt_lineage_record.schema.json",
      "title": "Validated dbt model lineage",
      "description": "Only model edges derived by the broker from captured attempt-bound native dbt artifacts and fixed row dataset bindings. No SQL, environment, artifact paths or arbitrary manifest metadata.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "invocation",
        "attempt_id",
        "invocation_id",
        "files",
        "models"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "invocation": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://healthcare-hai-prediction.invalid/orchestration/submission_request.schema.json",
          "title": "Submission request",
          "description": "Version 2 caller identity and fixed launch selection. Callers cannot supply datasets or override launch specifications.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "template",
            "run_id",
            "mode",
            "attempt",
            "request_version",
            "dag_id",
            "task_id",
            "dag_run_id"
          ],
          "properties": {
            "request_version": {
              "const": 2
            },
            "dag_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 250,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"
            },
            "task_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 250,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"
            },
            "dag_run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 250,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+~=-]*$(?![\\s\\S])"
            },
            "template": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,40}$"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
            },
            "mode": {
              "enum": [
                "fixture",
                "publish_fixture",
                "real"
              ]
            },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            }
          }
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^at-[A-Za-z0-9_-]{1,90}$"
        },
        "invocation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,249}$"
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest.json",
            "run_results.json"
          ],
          "properties": {
            "manifest.json": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "run_results.json": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "models": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "status",
              "inputs",
              "outputs"
            ],
            "properties": {
              "model": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,249}$"
              },
              "status": {
                "enum": [
                  "success",
                  "pass",
                  "warn",
                  "error",
                  "fail",
                  "skipped"
                ]
              },
              "inputs": {
                "type": "array",
                "maxItems": 1000,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "namespace",
                    "name"
                  ],
                  "properties": {
                    "namespace": {
                      "type": "string",
                      "maxLength": 250,
                      "pattern": "^(file|s3://[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]|iceberg://[A-Za-z0-9_.:-]+(/[A-Za-z0-9_.-]+)*)$(?![\\s\\S])"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^(?:[A-Za-z0-9_./:-]|\\{(?:run_id|mode|run_dir|build_file|checkout)\\})+$(?![\\s\\S])",
                      "not": {
                        "pattern": "(^|/)(\\.\\.|secrets?|\\.env|[^/]*\\.(key|pem))(/|$)"
                      }
                    }
                  }
                }
              },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "namespace",
                    "name"
                  ],
                  "properties": {
                    "namespace": {
                      "type": "string",
                      "maxLength": 250,
                      "pattern": "^(file|s3://[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]|iceberg://[A-Za-z0-9_.:-]+(/[A-Za-z0-9_.-]+)*)$(?![\\s\\S])"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^(?:[A-Za-z0-9_./:-]|\\{(?:run_id|mode|run_dir|build_file|checkout)\\})+$(?![\\s\\S])",
                      "not": {
                        "pattern": "(^|/)(\\.\\.|secrets?|\\.env|[^/]*\\.(key|pem))(/|$)"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "name"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "maxLength": 250,
          "pattern": "^(file|s3://[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]|iceberg://[A-Za-z0-9_.:-]+(/[A-Za-z0-9_.-]+)*)$(?![\\s\\S])"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?:[A-Za-z0-9_./:-]|\\{(?:run_id|mode|run_dir|build_file|checkout)\\})+$(?![\\s\\S])",
          "not": {
            "pattern": "(^|/)(\\.\\.|secrets?|\\.env|[^/]*\\.(key|pem))(/|$)"
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "inputs",
        "outputs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "inputs": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dataset"
          }
        },
        "outputs": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dataset"
          }
        }
      }
    },
    "snapshot_record": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://healthcare-hai-prediction.invalid/orchestration/snapshot_record.schema.json",
      "title": "Produced output snapshot record",
      "description": "Version 1 immutable output identities bound to the full v2 producing broker invocation. The broker also enforces declaration membership, unique dataset identities, successful completion, signed-64-bit Iceberg IDs and the S3 UTF-8 byte bound.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "invocation",
        "outputs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "invocation": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://healthcare-hai-prediction.invalid/orchestration/submission_request.schema.json",
          "title": "Submission request",
          "description": "Version 2 caller identity and fixed launch selection. Callers cannot supply datasets or override launch specifications.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "template",
            "run_id",
            "mode",
            "attempt",
            "request_version",
            "dag_id",
            "task_id",
            "dag_run_id"
          ],
          "properties": {
            "request_version": {
              "const": 2
            },
            "dag_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 250,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"
            },
            "task_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 250,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"
            },
            "dag_run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 250,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+~=-]*$(?![\\s\\S])"
            },
            "template": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,40}$"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
            },
            "mode": {
              "enum": [
                "fixture",
                "publish_fixture",
                "real"
              ]
            },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "name",
              "snapshot"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "maxLength": 250,
                "pattern": "^(file|s3://[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]|iceberg://[A-Za-z0-9_.:-]+(/[A-Za-z0-9_.-]+)*)$(?![\\s\\S])"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?:[A-Za-z0-9_./:-]|\\{(?:run_id|mode|run_dir|build_file|checkout)\\})+$(?![\\s\\S])",
                "not": {
                  "pattern": "(^|/)(\\.\\.|secrets?|\\.env|[^/]*\\.(key|pem))(/|$)"
                }
              },
              "snapshot": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "const": "file_sha256"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "const": "iceberg_snapshot"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,18}$(?![\\s\\S])"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "const": "s3_object_version"
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024,
                        "not": {
                          "anyOf": [
                            {
                              "const": "null"
                            },
                            {
                              "pattern": "(^|/)(secrets?|\\.env|\\.aws|credentials|[^/]*\\.(key|pem))(/|$)"
                            }
                          ]
                        },
                        "pattern": "^[^\\u0000-\\u0020\\u007f-\\u009f]+$(?![\\s\\S])"
                      }
                    }
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "namespace": {
                      "const": "file"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "snapshot": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "id"
                      ],
                      "properties": {
                        "kind": {
                          "const": "file_sha256"
                        },
                        "id": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "namespace": {
                      "pattern": "^iceberg://"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "snapshot": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "id"
                      ],
                      "properties": {
                        "kind": {
                          "const": "iceberg_snapshot"
                        },
                        "id": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]{0,18}$(?![\\s\\S])"
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "namespace": {
                      "pattern": "^s3://"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "snapshot": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "id"
                      ],
                      "properties": {
                        "kind": {
                          "const": "s3_object_version"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1024,
                          "not": {
                            "anyOf": [
                              {
                                "const": "null"
                              },
                              {
                                "pattern": "(^|/)(secrets?|\\.env|\\.aws|credentials|[^/]*\\.(key|pem))(/|$)"
                              }
                            ]
                          },
                          "pattern": "^[^\\u0000-\\u0020\\u007f-\\u009f]+$(?![\\s\\S])"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "invocation": {
                "properties": {
                  "mode": {
                    "const": "fixture"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "outputs": {
                "items": {
                  "properties": {
                    "namespace": {
                      "const": "file"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "invocation": {
                "properties": {
                  "mode": {
                    "enum": [
                      "real",
                      "publish_fixture"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "outputs": {
                "items": {
                  "properties": {
                    "namespace": {
                      "not": {
                        "const": "file"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "input_snapshot_record": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://healthcare-hai-prediction.invalid/orchestration/input_snapshot_record.schema.json",
      "title": "Pinned input snapshot record",
