              "type": "string",
              "minLength": 1,
              "maxLength": 250,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+~=-]*$(?![\\s\\S])"
            },
            "template": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,40}$"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
            },
            "mode": {
              "enum": [
