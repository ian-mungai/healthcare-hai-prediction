{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthcare-hai-prediction.invalid/orchestration/ecs_real_run_request.schema.json",
  "title": "Real AWS read run preparation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "owner_approval_reference",
    "code_sha256",
    "price_evidence_sha256",
    "cost_ceiling_usd",
    "window_start_utc",
    "window_deadline_utc",
    "source_inventory_sha256",
    "dataset_uploads",
    "source_kind",
    "source_inventory"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "owner_approval_reference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./:-]{1,200}$"
    },
    "code_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "price_evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cost_ceiling_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "window_start_utc": {
      "type": "string",
      "format": "date-time"
    },
    "window_deadline_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source_inventory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_uploads": {
      "type": "array",
      "maxItems": 0
    },
    "source_kind": {
      "const": "existing_s3_lakehouse"
    },
    "source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_catalog",
        "destination_catalog",
        "publications",
        "tables"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "source_catalog": {
          "const": "mac"
        },
        "destination_catalog": {
          "const": "aws"
        },
        "publications": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "layer",
              "run_id",
              "receipt_sha256",
              "reservation"
            ],
            "properties": {
              "layer": {
                "enum": [
                  "silver",
                  "gold"
                ]
              },
              "run_id": {
                "type": "string",
                "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
              },
              "receipt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reservation": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_:-]{1,127}$"
              }
            }
          }
        },
        "tables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "name",
              "table_uuid",
              "snapshot_id",
              "metadata_location",
              "metadata_version",
              "metadata_sha256",
              "current_snapshot_id",
              "location",
              "metadata_size"
            ],
            "properties": {
              "namespace": {
                "enum": [
                  "bronze",
                  "silver",
                  "gold",
                  "features"
                ]
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,127}$"
              },
              "table_uuid": {
                "type": "string",
                "format": "uuid"
              },
              "snapshot_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "metadata_location": {
                "type": "string",
                "pattern": "^s3://[a-z0-9][a-z0-9-]{1,61}[a-z0-9]/lakehouse/[A-Za-z0-9_./-]+$"
              },
              "metadata_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "not": {
                  "const": "null"
                }
              },
              "metadata_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "current_snapshot_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "location": {
                "type": "string",
                "pattern": "^s3://[a-z0-9][a-z0-9-]{1,61}[a-z0-9]/lakehouse/[A-Za-z0-9_./-]+$"
              },
              "metadata_size": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
