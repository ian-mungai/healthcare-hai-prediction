{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthcare-hai-prediction.invalid/orchestration/submission_request.schema.json",
  "title": "Submission request",
  "description": "Version 2 caller identity and fixed launch selection. Callers cannot supply datasets or override launch specifications.",
  "type": "object",
  "additionalProperties": false,
  "required": ["template", "run_id", "mode", "attempt", "request_version", "dag_id", "task_id", "dag_run_id"],
  "properties": {
    "request_version": {"const": 2},
    "dag_id": {"type": "string", "minLength": 1, "maxLength": 250, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 250, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"},
    "dag_run_id": {"type": "string", "minLength": 1, "maxLength": 250, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+~=-]*$(?![\\s\\S])"},
    "template": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},
    "mode": {"enum": ["fixture", "publish_fixture", "real"]},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 99}
  }
}
