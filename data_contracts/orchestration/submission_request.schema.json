{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthcare-hai-prediction.invalid/orchestration/submission_request.schema.json",
  "title": "Submission request",
  "description": "Version 2 caller identity and fixed launch selection. Callers cannot supply datasets or override launch specifications.",
  "type": "object",
  "additionalProperties": false,
  "required": ["template", "run_id", "mode", "attempt", "request_version", "dag_id", "task_id", "dag_run_id"],
  "properties": {
    "request_version": {"const": 2},
    "dag_id": {"type": "string", "minLength": 1, "maxLength": 250, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 250, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"},
    "dag_run_id": {"type": "string", "minLength": 1, "maxLength": 250, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+~=-]*$(?![\\s\\S])"},
    "template": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},
    "mode": {"enum": ["fixture", "publish_fixture", "real"]},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 99},
    "input_run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},
    "training": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "features_run": {"type": "string", "pattern": "^(latest|[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8})$"},
        "population": {"enum": ["primary", "sensitivity"]},
        "hai_types": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["HAI_1", "HAI_2", "HAI_3", "HAI_4", "HAI_5", "HAI_6"]}},
        "trigger": {"type": "string", "pattern": "^(manual|drift:[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8})$"},
        "mlflow": {"enum": ["local", "aws"]},
        "hai_type": {"enum": ["HAI_1", "HAI_2", "HAI_3", "HAI_4", "HAI_5", "HAI_6"]},
        "model_version": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
        "promotion_mode": {"enum": ["promote", "rollback"]}
      }
    }
  },
  "allOf": [
    {"if": {"required": ["input_run_id"]}, "then": {"properties": {"template": {"const": "pin_silver"}}}},
    {"if": {"properties": {"dag_id": {"enum": ["training_dag", "model_promotion_dag"]}}, "required": ["dag_id"]}, "then": {"required": ["training"]}, "else": {"not": {"required": ["training"]}}},
    {"if": {"required": ["training"], "properties": {"dag_id": {"const": "training_dag"}}}, "then": {"properties": {"training": {"required": ["features_run", "population", "hai_types", "trigger", "mlflow"], "maxProperties": 5}}}},
    {"if": {"required": ["training"], "properties": {"dag_id": {"const": "model_promotion_dag"}}}, "then": {"properties": {"training": {"required": ["hai_type", "model_version", "promotion_mode", "mlflow"], "maxProperties": 4}}}}
  ]
}
