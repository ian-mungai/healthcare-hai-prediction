{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthcare-hai-prediction.invalid/orchestration/remote_run.schema.json",
  "title": "Remote run preparation contracts",
  "description": "Draft shapes for immutable references, bounded records, seals and read-only catalog registration. Not wired to production acceptance.",
  "$defs": {
    "object_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "version_id",
        "sha256",
        "size",
        "try_id"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$(?![\\s\\S])",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "version_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "null"
          },
          "pattern": "^[^\\u0000-\\u0020\\u007f-\\u009f]+$(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "try_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$(?![\\s\\S])"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "version_id",
        "sha256",
        "size",
        "try_id",
        "path"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$(?![\\s\\S])",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "version_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "null"
          },
          "pattern": "^[^\\u0000-\\u0020\\u007f-\\u009f]+$(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 33554432
        },
        "try_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$(?![\\s\\S])"
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$(?![\\s\\S])",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        }
      }
    },
    "input_map": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "version_id",
          "sha256",
          "size",
          "path"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$(?![\\s\\S])",
            "not": {
              "pattern": "(^|/)\\.\\.?(/|$)"
            }
          },
          "version_id": {
            "type": "string",
            "minLength": 1,
            "not": {
              "const": "null"
            },
            "pattern": "^[^\\u0000-\\u0020\\u007f-\\u009f]+$(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$(?![\\s\\S])",
            "not": {
              "pattern": "(^|/)\\.\\.?(/|$)"
            }
          }
        }
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "layer",
        "generation",
        "sha256",
        "size",
        "source_key",
        "source_version_id",
        "validation_attempt"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$(?![\\s\\S])"
        },
        "layer": {
          "enum": [
            "silver",
            "gold"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "source_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$(?![\\s\\S])",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "source_version_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "null"
          },
          "pattern": "^[^\\u0000-\\u0020\\u007f-\\u009f]+$(?![\\s\\S])"
        },
        "validation_attempt": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$(?![\\s\\S])"
        }
      }
    },
    "catalog_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_catalog",
        "destination_catalog",
        "publications",
        "tables"
      ],
      "properties": {
        "schema": {
          "type": "integer",
          "const": 1
        },
        "source_catalog": {
          "const": "mac"
        },
        "destination_catalog": {
          "const": "aws"
        },
        "publications": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "layer",
              "run_id",
              "receipt_sha256",
              "reservation"
            ],
            "properties": {
              "layer": {
                "enum": [
                  "silver",
                  "gold"
                ]
              },
              "run_id": {
                "type": "string",
                "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$(?![\\s\\S])"
              },
              "receipt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
              },
              "reservation": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
              }
            }
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "layer": {
                    "const": "silver"
                  }
                }
              }
            },
            {
              "contains": {
                "properties": {
                  "layer": {
                    "const": "gold"
                  }
                }
              }
            }
          ]
        },
        "tables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "name",
              "table_uuid",
              "location",
              "metadata_location",
              "metadata_version",
              "metadata_sha256",
              "metadata_size",
              "snapshot_id",
              "current_snapshot_id"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,127}$(?![\\s\\S])"
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,127}$(?![\\s\\S])"
              },
              "table_uuid": {
                "type": "string",
                "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$(?![\\s\\S])"
              },
              "location": {
                "type": "string",
                "pattern": "^s3://[a-z0-9][a-z0-9.-]+/lakehouse/[^\\s\\u0000-\\u001f\\u007f?#]+$(?![\\s\\S])",
                "not": {
                  "pattern": "(^|/)\\.\\.?(/|$)|/lakehouse/.*//"
                }
              },
              "metadata_location": {
                "type": "string",
                "pattern": "^s3://[a-z0-9][a-z0-9.-]+/lakehouse/[^\\s\\u0000-\\u001f\\u007f?#]+$(?![\\s\\S])",
                "not": {
                  "pattern": "(^|/)\\.\\.?(/|$)|/lakehouse/.*//"
                }
              },
              "metadata_version": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "const": "null"
                },
                "pattern": "^[^\\u0000-\\u0020\\u007f-\\u009f]+$(?![\\s\\S])"
              },
              "metadata_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
              },
              "metadata_size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 33554432
              },
              "snapshot_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "current_snapshot_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              }
            }
          }
        }
      }
    },
    "run_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "generation",
        "live_try_id",
        "objects"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$(?![\\s\\S])"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "live_try_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$(?![\\s\\S])"
        },
        "objects": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$(?![\\s\\S])",
            "not": {
              "pattern": "(^|/)\\.\\.?(/|$)"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/object_ref"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/object_ref"
    },
    {
      "$ref": "#/$defs/record"
    },
    {
      "$ref": "#/$defs/input_map"
    },
    {
      "$ref": "#/$defs/seal"
    },
    {
      "$ref": "#/$defs/catalog_inventory"
    },
    {
      "$ref": "#/$defs/run_map"
    }
  ]
}
