{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthcare-hai-prediction.invalid/orchestration/dbt_lineage_record.schema.json",
  "title": "Validated dbt model lineage",
  "description": "Only model edges derived by the broker from captured attempt-bound native dbt artifacts and fixed row dataset bindings. No SQL, environment, artifact paths or arbitrary manifest metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "invocation",
    "attempt_id",
    "invocation_id",
    "files",
    "models"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "invocation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://healthcare-hai-prediction.invalid/orchestration/submission_request.schema.json",
      "title": "Submission request",
      "description": "Version 2 caller identity and fixed launch selection. Callers cannot supply datasets or override launch specifications.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "run_id",
        "mode",
        "attempt",
        "request_version",
        "dag_id",
        "task_id",
        "dag_run_id"
      ],
      "properties": {
        "request_version": {
          "const": 2
        },
        "dag_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"
        },
        "dag_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+~=-]*$(?![\\s\\S])"
        },
        "template": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,40}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
        },
        "mode": {
          "enum": [
            "fixture",
            "publish_fixture",
            "real"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^at-[A-Za-z0-9_-]{1,90}$"
    },
    "invocation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,249}$"
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest.json",
        "run_results.json"
      ],
      "properties": {
        "manifest.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "run_results.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "models": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "status",
          "inputs",
          "outputs"
        ],
        "properties": {
          "model": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,249}$"
          },
          "status": {
            "enum": [
              "success",
              "pass",
              "warn",
              "error",
              "fail",
              "skipped"
            ]
          },
          "inputs": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "namespace",
                "name"
              ],
              "properties": {
                "namespace": {
                  "type": "string",
                  "maxLength": 250,
                  "pattern": "^(file|s3://[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]|iceberg://[A-Za-z0-9_.:-]+(/[A-Za-z0-9_.-]+)*)$(?![\\s\\S])"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^(?:[A-Za-z0-9_./:-]|\\{(?:run_id|mode|run_dir|build_file|checkout)\\})+$(?![\\s\\S])",
                  "not": {
                    "pattern": "(^|/)(\\.\\.|secrets?|\\.env|[^/]*\\.(key|pem))(/|$)"
                  }
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "namespace",
                "name"
              ],
              "properties": {
                "namespace": {
                  "type": "string",
                  "maxLength": 250,
                  "pattern": "^(file|s3://[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]|iceberg://[A-Za-z0-9_.:-]+(/[A-Za-z0-9_.-]+)*)$(?![\\s\\S])"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^(?:[A-Za-z0-9_./:-]|\\{(?:run_id|mode|run_dir|build_file|checkout)\\})+$(?![\\s\\S])",
                  "not": {
                    "pattern": "(^|/)(\\.\\.|secrets?|\\.env|[^/]*\\.(key|pem))(/|$)"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
