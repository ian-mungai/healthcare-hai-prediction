{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-job placement history",
  "description": "One live target per attempt. Task identities stay separate from Docker container identities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requested_target", "queued_at", "deadline_utc", "catalog_epoch", "live_try", "placements"],
  "properties": {
    "version": {"const": 1},
    "requested_target": {"enum": ["auto", "ecs", "docker"]},
    "queued_at": {"type": "number", "minimum": 0},
    "deadline_utc": {"type": "integer", "minimum": 1},
    "catalog_epoch": {"type": ["integer", "null"], "minimum": 1},
    "live_try": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,100}$(?![\\s\\S])"},
    "catalog_authority": {
      "type": [
        "object",
        "null"
      ]
    },
    "writer_authorization": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "qualification",
        "layer_activation",
        "publish_approval"
      ],
      "properties": {
        "qualification": {
          "type": "string",
          "minLength": 1
        },
        "layer_activation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "publish_approval": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_class",
        "registry_kind",
        "run_id",
        "mode",
        "layer",
        "namespaces"
      ],
      "properties": {
        "job_class": {
          "enum": [
            "offline",
            "seal",
            "lakehouse_read",
            "lakehouse_write"
          ]
        },
        "registry_kind": {
          "enum": [
            "real",
            "rehearsal",
            "test"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "layer": {
          "type": [
            "string",
            "null"
          ]
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["try_id", "target", "capacity_provider", "state", "reason", "created_at", "deadline_utc", "cpu", "memory_mib", "storage_gib", "task_arn", "started"],
        "properties": {
          "try_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$(?![\\s\\S])"},
          "target": {"enum": ["ecs", "docker"]},
          "capacity_provider": {"enum": ["FARGATE_SPOT", "FARGATE", null]},
          "state": {"enum": ["intent", "pending", "running", "unknown", "stopping", "fenced", "complete"]},
          "reason": {"enum": ["aws_first", "spot_capacity_unavailable", "capacity", "patience", "cloud_cap", "breaker"]},
          "created_at": {"type": "number", "minimum": 0},
          "deadline_utc": {"type": "integer", "minimum": 1},
          "cpu": {"type": "integer", "minimum": 1024, "maximum": 16384},
          "memory_mib": {"type": "integer", "minimum": 2048, "maximum": 122880},
          "storage_gib": {"type": "integer", "minimum": 21, "maximum": 200},
          "task_arn": {"type": ["string", "null"], "pattern": "^arn:aws:ecs:[a-z0-9-]+:[0-9]{12}:task/[A-Za-z0-9_/-]+$(?![\\s\\S])"},
          "started": {"type": "boolean"},
          "fenced_at": {"type": "number", "minimum": 0},
          "no_start": {"type": "boolean"},
          "catalog_authority": {
            "type": [
              "object",
              "null"
            ]
          },
          "writer_authorization": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "qualification",
              "layer_activation",
              "publish_approval"
            ],
            "properties": {
              "qualification": {
                "type": "string",
                "minLength": 1
              },
              "layer_activation": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "publish_approval": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          "job_class": {
            "enum": [
              "offline",
              "seal",
              "lakehouse_read",
              "lakehouse_write"
            ]
          },
          "dispatch_attempted": {
            "type": "boolean"
          },
          "dispatch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request",
              "request_sha256",
              "job_reference",
              "definition",
              "project_tag",
              "clock_observation",
              "sent"
            ],
            "properties": {
              "request": {
                "type": "object"
              },
              "request_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "job_reference": {
                "type": "object"
              },
              "definition": {
                "type": "object"
              },
              "project_tag": {
                "type": "string"
              },
              "clock_observation": {
                "type": "object"
              },
              "sent": {
                "const": true
              }
            }
          },
          "cap_before": {
            "type": "object", "additionalProperties": false, "required": ["tasks", "cpu", "memory_mib"],
            "properties": {"tasks": {"type": "integer", "minimum": 0}, "cpu": {"type": "integer", "minimum": 0}, "memory_mib": {"type": "integer", "minimum": 0}}
          }
        },
        "allOf": [
          {"if": {"properties": {"target": {"const": "ecs"}}}, "then": {"properties": {"capacity_provider": {"enum": ["FARGATE_SPOT", "FARGATE"]}}}},
          {"if": {"properties": {"target": {"const": "docker"}}}, "then": {"properties": {"capacity_provider": {"type": "null"}, "task_arn": {"type": "null"}}}},
          {"if": {"properties": {"state": {"const": "fenced"}}}, "then": {"required": ["fenced_at", "no_start"]}}
        ]
      }
    }
  }
}
