{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthcare-hai-prediction.invalid/orchestration/input_snapshot_record.schema.json",
  "title": "Pinned input snapshot record",
  "description": "Version 1 immutable input identities bound to the full v2 consuming broker invocation. The broker also enforces declaration membership, exact coverage of the declared inputs, unique dataset identities, successful completion, equality with the pins frozen at intent, signed-64-bit Iceberg IDs and the S3 UTF-8 byte bound. A fixture run may name only local files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "invocation",
    "inputs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "invocation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://healthcare-hai-prediction.invalid/orchestration/submission_request.schema.json",
      "title": "Submission request",
      "description": "Version 2 caller identity and fixed launch selection. Callers cannot supply datasets or override launch specifications.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "run_id",
        "mode",
        "attempt",
        "request_version",
        "dag_id",
        "task_id",
        "dag_run_id"
      ],
      "properties": {
        "request_version": {
          "const": 2
        },
        "dag_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$(?![\\s\\S])"
        },
        "dag_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+~=-]*$(?![\\s\\S])"
        },
        "template": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,40}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
        },
        "mode": {
          "enum": [
            "fixture",
            "publish_fixture",
            "real"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "input_run_id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
        },
        "target": {
          "enum": [
            "auto",
            "ecs",
            "docker"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "input_run_id"
            ]
          },
          "then": {
            "properties": {
              "template": {
                "const": "pin_silver"
              }
            }
          }
        }
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "name",
          "snapshot"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "maxLength": 250,
            "pattern": "^(file|s3://[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]|iceberg://[A-Za-z0-9_.:-]+(/[A-Za-z0-9_.-]+)*)$(?![\\s\\S])"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?:[A-Za-z0-9_./:-]|\\{(?:run_id|mode|run_dir|build_file|checkout)\\})+$(?![\\s\\S])",
            "not": {
              "pattern": "(^|/)(\\.\\.|secrets?|\\.env|[^/]*\\.(key|pem))(/|$)"
            }
          },
          "snapshot": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id"
                ],
                "properties": {
                  "kind": {
                    "const": "file_sha256"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id"
                ],
                "properties": {
                  "kind": {
                    "const": "iceberg_snapshot"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,18}$(?![\\s\\S])"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id"
                ],
                "properties": {
                  "kind": {
                    "const": "s3_object_version"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "not": {
                      "anyOf": [
                        {
                          "const": "null"
                        },
                        {
                          "pattern": "(^|/)(secrets?|\\.env|\\.aws|credentials|[^/]*\\.(key|pem))(/|$)"
                        }
                      ]
                    },
                    "pattern": "^[^\\u0000-\\u0020\\u007f-\\u009f]+$(?![\\s\\S])"
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "namespace": {
                  "const": "file"
                }
              }
            },
            "then": {
              "properties": {
                "snapshot": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id"
                  ],
                  "properties": {
                    "kind": {
                      "const": "file_sha256"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "namespace": {
                  "pattern": "^iceberg://"
                }
              }
            },
            "then": {
              "properties": {
                "snapshot": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id"
                  ],
                  "properties": {
                    "kind": {
                      "const": "iceberg_snapshot"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]{0,18}$(?![\\s\\S])"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "namespace": {
                  "pattern": "^s3://"
                }
              }
            },
            "then": {
              "properties": {
                "snapshot": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id"
                  ],
                  "properties": {
                    "kind": {
                      "const": "s3_object_version"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "not": {
                        "anyOf": [
                          {
                            "const": "null"
                          },
                          {
                            "pattern": "(^|/)(secrets?|\\.env|\\.aws|credentials|[^/]*\\.(key|pem))(/|$)"
                          }
                        ]
                      },
                      "pattern": "^[^\\u0000-\\u0020\\u007f-\\u009f]+$(?![\\s\\S])"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "invocation": {
            "properties": {
              "mode": {
                "const": "fixture"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "items": {
              "properties": {
                "namespace": {
                  "const": "file"
                }
              }
            }
          }
        }
      }
    }
  ]
}
