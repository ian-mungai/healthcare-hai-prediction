{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declared caller identity run facet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_producer",
    "_schemaURL",
    "eventId",
    "runId",
    "attempt"
  ],
  "properties": {
    "_producer": {
      "const": "https://github.com/ian-mungai/healthcare-hai-prediction"
    },
    "_schemaURL": {
      "type": "string",
      "format": "uri"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^(?:(?:ingestion|promotion|features|metadata|research|serving|bronze|silver|gold)_[a-f0-9]{8}(?:_(?:[2-9]|[1-9][0-9]))?|(?:features|research|training|drift)_(?:gradient_boosting|fixed_effects|mixed_effects|elastic_net|spatial|ols)_[a-f0-9]{8}(?:_(?:[2-9]|[1-9][0-9]))?|(?:canary_deploy|stable_deploy|promote|release|canary|notice)_(?:ssi_hysterectomy|ssi_colon|clabsi|cauti|cdiff|mrsa)_[a-f0-9]{8}(?:_(?:[2-9]|[1-9][0-9]))?|ingestion_retry_[a-f0-9]{8}(?:_(?:[2-9]|[1-9][0-9]))?_[1-2])$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "launcherAttemptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
