# SQLFluff profiles run by scripts/quality/lint_sources.py sql through pre-commit and scripts/run_ci.sh.
# Covers dbt/models/, dbt/tests/, dbt/macros/, services/analytics/resources.sql and
# services/lakehouse/polaris/create-polaris-schema.sql using the pinned .tools/sqlfluff environment
# (scripts/quality/install_sqlfluff.py). Style: lowercase keywords and functions, four-space indentation,
# trailing commas and a 160-character line length.
[sqlfluff]
dialect = duckdb
templater = dbt
max_line_length = 160
# Fail the run on any rule violation, and on files SQLFluff cannot template or parse.
processes = 1
# The generated wide feature models (dbt/models/features/matrix) are larger than the default 20000-byte limit, above which SQLFluff skips a file with only a warning.
large_file_skip_byte_limit = 0

[sqlfluff:templater:dbt]
project_dir = dbt
profiles_dir = dbt
profile = hai
# An in-memory DuckDB with nothing attached: compiling needs no catalog, credentials or network.
target = lint

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4
# Jinja loops that build one CTE per table do not add an indent level of their own.
template_blocks_indent = False

[sqlfluff:layout:type:comma]
line_position = trailing

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower
