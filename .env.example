# Settings of a person and variables that production code reads. Variables that only test code reads are in config/quality/test_env_names.json.
AWS_REGION=your-aws-region
AWS_PROFILE=example_project_dev
AWS_ACCOUNT_ID=your-aws-account-id
PROJECT_NAME=example_project
ENVIRONMENT=dev
S3_BUCKET=your-s3-bucket

# The standard AWS variable. The startup check (scripts/infrastructure/startup_check.py) reads it only when AWS_REGION is unset or empty. Leave it unset locally.
# AWS_DEFAULT_REGION=your-aws-region

# Optional. One plain address that bootstrap subscribes to every project alert topic (run failures and cost alerts) through the alerts root, infra/alerts.
# AWS emails a confirmation link for each topic; a subscription sends nothing until it is confirmed. Leave it empty for development without alerts.
ALERT_EMAIL=

# Set by pre-commit only when it checks a commit range; never set these in .env.
# The removed-names check in scripts/quality/repo_checks.py diffs that range.
# PRE_COMMIT_FROM_REF=origin/main
# PRE_COMMIT_TO_REF=HEAD

# Set by scripts/quality/ci_hooks.py for each shard of the test-checks hook; never set these in .env. CHECKS_SHARD is K/N, the shard that
# scripts/quality/run_checks_e2e.py runs, and CHECKS_SHARD_DIRECTORY is the folder that receives that shard's manifest.json.
# CHECKS_SHARD=1/4
# CHECKS_SHARD_DIRECTORY=/tmp/example_shards

# Git sets this to : for unedited commit messages; never set it in .env.
# GIT_EDITOR=:

# Set by the launcher inside the lakehouse Spark container from AWS Parameter Store (scripts/lakehouse/catalog.py stores them
# there); never set these in .env.
# POLARIS_URI=http://polaris:8181/api/catalog
# POLARIS_CLIENT_ID=root
# POLARIS_CLIENT_SECRET=

# Set in the job definition of a Feast job on AWS (scripts/features/feast_aws.py reads both): FEAST_PROFILE is local (the default) or aws; the registry
# bucket is a placeholder here, never a real bucket name. Never set them in .env.
# FEAST_PROFILE=aws
# FEAST_REGISTRY_BUCKET=your-registry-bucket

# Set by scripts/lakehouse/catalog.py for each Spark job from the memory free at launch (scripts/lakehouse/memory_budget.py);
# scripts/lakehouse/session.py requires it and has no default. Never set it in .env.
# SPARK_JOB_MEMORY=20g

# Computed per launch by scripts/lakehouse/memory_budget.py on the Mac, and derived inside an ECS task from the capacity of its container by
# scripts/lakehouse/task_capacity.py (a launch override is clipped to that capacity); never set these in .env.
# JOB_MEMORY_LIMIT=21474836480
# DUCKDB_MEMORY_LIMIT=17GB
# JOB_THREADS=16

# Passed by a launcher client to the jobs it starts: the absolute deadline the launcher fixes in a finite job's container (epoch seconds, read by
# services/hai/deadline_run.py). The run lock command line (scripts/lakehouse/run_lock.py) reads the token of a run it acquired from RUN_LOCK_TOKEN. A run's token
# lives in the token store, not in the environment. Never set these in .env.
# RUN_LOCK_TOKEN=
# HAI_DEADLINE_UTC=1791800000

# Names the Docker socket as the Docker command does (orchestration/launcher.py); unset, the launcher reads the current Docker
# context. Never set it in .env.
# DOCKER_HOST=unix:///var/run/docker.sock

# Supplied by the operating system and preserved by launch/check scripts; never set this in .env.
# PATH=/example/tool/bin

# Supplied by the operating system. The startup check gives its child process a scratch folder as HOME (scripts/infrastructure/startup_check.py) and its tests read that value
# back from the child; never set this in .env.
# HOME=/example/home

# Set only by the reference-documents E2E (scripts/acquisition/run_reference_documents_e2e.py): it puts its
# offline stand-in first for the download processes it starts and restores the earlier value after. Never set it in .env.
# PYTHONPATH=

# Set by GitHub Actions for the plan job (scripts/quality/ci_reuse.py appends its answer and its summary to these files); never set
# them in .env.
# GITHUB_OUTPUT=/example/runner/github_output
# GITHUB_STEP_SUMMARY=/example/runner/step_summary.md

# Set by the first Repository Hooks job step to its start time in Unix seconds. The hook runner subtracts elapsed setup time.
# Leave this unset locally and never set it in .env.
# JOB_STARTED=1700000000

# Set only by a feature CI shard job. Never set this in .env.
# FEATURE_SHARD=1/8

# Set by scripts/process.py run_command and by scripts/run_ci.sh for each program they start in a new session: a launch made inside that session
# is nested and stays in it. Never set this in .env.
# PROCESS_LAUNCH_SESSION=1

# The core budget of the local gate's admission queue (scripts/run_ci.sh): a whole number above 0. Unset, the budget is core_budget in
# config/quality/ci_groups.json (12) on a local run and the CPU count (nproc) on hosted CI; a set value replaces both.
# CI_CORE_BUDGET=10

# Set by the pre-push gate for the scripts/run_ci.sh it starts, so that run_ci.sh skips its own Docker release. Never set this in .env.
# HAI_DOCKER_RELEASE=outer

# The confirmation text that the policy apply command (infra/iam/scripts/manage_policies.py) asks for; scripts/infrastructure/alert_email.py passes it for the alert email list.
# Never set this in .env.
# CONFIRM_IAM_POLICIES=

# Set by every Airflow task definition on AWS to the deployment's environment (dev or prod). ingestion_dag runs on its monthly schedule only where this is prod;
# unset, it has no schedule. Any other value fails the DAG file. The owner leaves it empty on the Mac.
# HAI_ENVIRONMENT=

# Set by ECS inside each task. The owner leaves it empty on the Mac.
# AWS_EXECUTION_ENV=

# Set by ECS inside each task. The owner leaves it empty on the Mac.
# AWS_CONTAINER_CREDENTIALS_RELATIVE_URI=

# Set by the ECS task definition. The owner leaves it empty on the Mac.
# HAI_DUCKDB_TEMP_DIRECTORY=

# Derived inside an ECS task from the free space of the spill filesystem (scripts/lakehouse/task_capacity.py). A value set here or by a launch override is
# clipped to that figure and never raised. The owner leaves it empty on the Mac.
# HAI_DUCKDB_MAX_TEMP_BYTES=

# Set by the layer driver for the features build: the time (epoch seconds) by which the phase must end. The build derives the time of its steps from it.
# HAI_PHASE_DEADLINE_EPOCH=

# Set by the ECS task definition. The owner leaves it empty on the Mac.
# HAI_SPARK_LOCAL_DIRECTORY=

# Set by ECS in every task container; the task guard reads it. Never set this in .env.
# ECS_CONTAINER_METADATA_URI_V4=

# Set by every Airflow task definition on AWS for the launch library (orchestration/airflow_steps.py): the cluster, the task family prefix, the Project tag, the log group,
# the host capacity provider, the host auto scaling group, the launch bucket, the Polaris and MLflow addresses of the jobs and the scratch folder. The owner leaves them empty on the Mac.
# HAI_LAUNCH_CLUSTER=
# HAI_LAUNCH_FAMILY_PREFIX=
# HAI_LAUNCH_PROJECT_TAG=
# HAI_LAUNCH_LOG_GROUP=
# HAI_LAUNCH_HOST_PROVIDER=
# HAI_LAUNCH_HOST_GROUP=
# HAI_LAUNCH_BUCKET=
# HAI_LAUNCH_POLARIS_URI=
# HAI_LAUNCH_MLFLOW_URI=
# HAI_LAUNCH_SCRATCH_PATH=

# Optional folder of the layer reports that the evidence task of a silver or gold DAG writes (orchestration/layer_report.py). Unset, it is /opt/airflow/logs/layer_reports.
# The owner leaves it empty on the Mac.
# HAI_LAUNCH_REPORT_DIR=/opt/airflow/logs/layer_reports

# Set by every Airflow task definition on AWS: usable_memory_mib=<MiB> system_reserve_mib=<MiB> of the host. The launch preflight runs a host job only from a task
# revision whose capacity label carries them. The owner leaves it empty on the Mac.
# HAI_LAUNCH_HOST_CAPACITY=

# Set by every Airflow task definition on AWS: the memory in MiB that one host job gets (services input host_job_cap_mib). The launch preflight refuses a launch while it
# is missing or not a whole number above 0, and refuses a host task revision that gives a job more. The owner leaves it empty on the Mac.
# HAI_LAUNCH_HOST_JOB_CAP_MIB=

# Set by every Airflow task definition on AWS to the one-slot pool of host jobs (host_jobs). Unset, the step tasks use Airflow's default pool. The owner leaves it empty on the Mac.
# HAI_LAUNCH_POOL=

# Set by the layer task definition for its guard container: the seconds after which the guard ends the task. The owner leaves it empty on the Mac.
# GUARD_SECONDS=

# Set by the layer task definition for its guard container: the seconds between two readings of the task metadata. The owner leaves it empty on the Mac.
# GUARD_INTERVAL_SECONDS=

# Set by the layer task definition for its guard container: the seconds one reading of the task metadata may take. The owner leaves it empty on the Mac.
# GUARD_READ_SECONDS=

# Folder of the local CI group passes that a full local run may reuse. The default is under data/.
# HAI_CI_PASSES_DIR=

# Git ref of the main branch for the local CI reuse. The default is origin/main.
# HAI_CI_MAIN_REF=

# Folder of the pinned TFLint rulesets. The default is the folder TFLint itself uses.
# TFLINT_PLUGIN_DIR=

# Training image digest for the MLflow run tags, set by the renderer. Never set this in .env.
# TRAINING_IMAGE_DIGEST=

# MLflow tracking URI of a training job, set by the job template. The owner command promote_owner reads all three from the shell, over a forwarded MLflow port
# (see its docstring; use http://localhost:5100). The username and password are the MLflow admin login of the deployment. Never set these in .env.
# MLFLOW_TRACKING_URI=
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# ARN of the alerts topic that the automatic promotion publishes its notice to (python -m scripts.training.auto_promotion notify), set by the job template. Never set this in .env.
# ALERTS_TOPIC_ARN=

# DVC remote of a training job, set by the job template. Never set this in .env.
# DVC_REMOTE_URL=

# Name of the project data bucket. Set by the task definition of each AWS job (the Airflow services name it HAI_LAUNCH_BUCKET). Never set this in .env.
# DATA_BUCKET_NAME=

# SHA-256 of the staged code archive of a run, passed by the launch to the fetch and pin containers of an AWS task. Never set this in .env.
# CODE_SHA256=

# Run kind of the Run 3 publisher job, passed by the launch from the run_kind parameter of ingestion_dag (scripts/acquisition/publisher_run.py): bootstrap (the default
# of a hand trigger) skips each unit that has a completion record, monthly downloads each unit again and compares its payload. Any other value is refused. Never set this in .env.
# PUBLISHER_RUN_KIND=bootstrap

# Bucket folder that new captures are written under, passed by the launch from the capture_root parameter of ingestion_dag: raw/ (the default of the publisher task
# definition) or one ingestion_test/<run ID>/ folder for a test run. Empty or unset in a local run keeps the original layout. Never set this in .env.
# HAI_CAPTURE_ROOT=raw/

# Original monthly run and day (1 to 7) of a retry, passed by the launch from the parameters of ingestion_retry_dag (scripts/acquisition/publisher_run.py).
# Only a retry has them: any other kind refuses them. Never set these in .env.
# PUBLISHER_ORIGINAL_RUN=
# PUBLISHER_RETRY_DAY=

# Run whose staged code a task fetches, passed by the launch. A run that derives from another fetches the code of that run. Never set this in .env.
# CODE_RUN_ID=

# Mode of a code task on the host (infra/services/scripts/code_fetch.py): install (the default), verify or restore. The launch passes it as an override of the code task
# (scripts/infrastructure/host_session.py), and only for verify and restore. Never set this in .env.
# CODE_MODE=verify

# Run ID of the silver or gold run that a gold or features task pins, passed by the launch. A features task of a model set pins a base run. Never set this in .env.
# INPUT_RUN_ID=

# Feature set of a features task: all for the single path, base, or m1 to m6 for a model set. Passed in the task overrides (job_overrides --feature-set). Never set this in .env.
# FEATURE_SET=

# Folder for temporary files. The Feast phase of the training task reads it as its run folder. The task sets it on its workspace volume. Leave it unset on the Mac.
# TMPDIR=

# Tables, target and dry run flag of a bronze job, checked by the launch preflight from the staged request and passed to its containers. Never set these in .env.
# BRONZE_TABLES=
# BRONZE_TARGET=
# BRONZE_DRY_RUN=

# SHA-256 of the bronze request the launch preflight checked and of the staged source inventory, passed to the bronze containers. Never set these in .env.
# BRONZE_REQUEST_SHA256=
# BRONZE_INVENTORY_SHA256=

# Serving request (HAI type, mode, candidate version and percent) that the launch preflight derives from the closed launch request and passes to the serve container. Never set this in .env.
# SERVING_REQUEST=

# S3 address of the deployment records, fixed in the serve task definition and in the model API service. Never set this in .env.
# MODEL_API_MANIFEST_URI=

# API key that the replay and compare tool presents to the model API. Pass it for one command from a key file and keep it out of .env.
# MODEL_API_KEY=

# Secret and port with which the chain DAG creates the catalog DAG run through the Airflow API. The Airflow service sets them. Never set these in .env.
# AIRFLOW__API_AUTH__JWT_SECRET=
# AIRFLOW_API_PORT=

# Set to false by the real-image rig (scripts/orchestration/real_image_dags.py) so that the mapped research trigger finds research_dag unpaused. Never set this in .env.
# AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=

# Set to true by GitHub Actions on hosted runners; the infrastructure E2E then requires the job firewall nft check to run. Never set this in .env.
# GITHUB_ACTIONS=

# MyPy's extra search path. While it is set, the importer check (scripts/quality/typecheck_importers.py) checks every covered file, because it cannot read the import roots it names.
# MYPYPATH=
