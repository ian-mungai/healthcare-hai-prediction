AWS_REGION=your-aws-region
AWS_PROFILE=example_project_dev
AWS_ACCOUNT_ID=your-aws-account-id
PROJECT_NAME=example_project
ENVIRONMENT=dev
S3_BUCKET=your-s3-bucket

# Set by scripts/infrastructure/run_e2e.py for the stand-in commands that run the host boot script in a temporary root; never set
# these in .env. The state folder and unit directory belong to the stand-ins, the IDs and names are synthetic and the others
# switch on one failure each.
# BOOT_STATE=/tmp/example_boot/state
# BOOT_SYSTEMD=/tmp/example_boot/systemd
# BOOT_NFTABLES_CONFIG=/tmp/example_boot/nftables.conf
# BOOT_STATE_INITIAL=nftables.service
# BOOT_IDS={"volume": "vol-0123456789abcdef0", "allocation": "eipalloc-0123456789abcdef0"}
# BOOT_DATA_VOLUME_NAME=example_project_host_data_dev
# BOOT_ADDRESS_NAME=example_project_host_dev
# BOOT_PROJECT_TAG=example_project
# BOOT_VOLUME_RESULT=
# BOOT_ALLOCATION_RESULT=
# BOOT_AWS_FAIL=describe-volumes
# BOOT_NFT_FAIL=1
# BOOT_SYSCTL_IGNORE=1
# BOOT_SYSTEMCTL_STALL=amazon-ssm-agent
# PROBE_UID=65534

# Set by pre-commit only when it checks a commit range; never set these in .env.
# The removed-names check in scripts/quality/repo_checks.py diffs that range.
# PRE_COMMIT_FROM_REF=origin/main
# PRE_COMMIT_TO_REF=HEAD

# Git sets this to : for unedited commit messages; never set it in .env.
# GIT_EDITOR=:

# Set by the launcher inside the lakehouse Spark container from AWS Parameter Store (scripts/lakehouse/catalog.py stores them
# there); never set these in .env.
# POLARIS_URI=http://polaris:8181/api/catalog
# POLARIS_CLIENT_ID=root
# POLARIS_CLIENT_SECRET=

# Set by the launcher in the lineage database dump job from AWS Parameter Store (services/lineage/db_dump.py reads it); never set it in .env.
# MARQUEZ_DB_PASSWORD=

# Set by scripts/lakehouse/catalog.py for each Spark job from the memory free at launch (scripts/lakehouse/memory_budget.py);
# scripts/lakehouse/session.py requires it and has no default. Never set it in .env.
# SPARK_JOB_MEMORY=20g

# Computed per launch by scripts/lakehouse/memory_budget.py; never set these in .env.
# JOB_MEMORY_LIMIT=21474836480
# DUCKDB_MEMORY_LIMIT=17GB
# JOB_THREADS=16

# Passed by a launcher client to the jobs it starts: the allocation a kit command inherits (orchestration/launcher.py
# allocate prints its ID) and the absolute deadline the launcher fixes in a finite job's container (epoch seconds, read by
# services/hai/deadline_run.py); never set these in .env. A run's token lives in the token store, not in the environment.
# The run lock command line (scripts/lakehouse/run_lock.py) still reads the token of a run it acquired from RUN_LOCK_TOKEN.
# RUN_LOCK_TOKEN=
# HAI_ALLOCATION=al-0123456789ab
# HAI_DEADLINE_UTC=1791800000

# Names the Docker socket as the Docker command does (orchestration/launcher.py); unset, the launcher reads the current Docker
# context. Never set it in .env.
# DOCKER_HOST=unix:///var/run/docker.sock

# Supplied by the operating system and preserved by launch/check scripts; never set this in .env.
# PATH=/example/tool/bin

# Optional, for a faster local loop only: iteration runs each offline acquisition E2E suite once and marks the run
# "not commit evidence" (scripts/acquisition/tests/test_offline_e2e.py). The hook and CI always use full.
# ACQUISITION_E2E_MODE=full

# Set only by the reference-documents E2E (scripts/acquisition/run_reference_documents_e2e.py): it puts its
# offline stand-in first for the download processes it starts and restores the earlier value after. Never set it in .env.
# PYTHONPATH=

# Set by GitHub Actions for the plan job (scripts/quality/ci_reuse.py appends its answer and its summary to these files); never set
# them in .env.
# GITHUB_OUTPUT=/example/runner/github_output
# GITHUB_STEP_SUMMARY=/example/runner/step_summary.md

# Set by the first Repository Hooks job step to its start time in Unix seconds. The hook runner subtracts elapsed setup time.
# Leave this unset locally and never set it in .env.
# JOB_STARTED=1700000000

# Set only by the CI reuse E2E (scripts/quality/run_ci_reuse_e2e.py) for its stand-in GitHub CLI: the answers it serves and the calls it
# records. Never set these in .env.
# FAKE_GH_ROUTES=/example/scratch/routes.json
# FAKE_GH_CALLS=/example/scratch/calls.log

# Set only by a feature CI shard job. Never set this in .env.
# FEATURE_SHARD=1/8

# Set only by the CI-groups end-to-end stubs to their scratch log file. Never set this in .env.
# STUB_LOG=stub.log

# Set only by the CI-groups end-to-end hook stand-in: the lock file it takes, how long it holds it in seconds
# and the exit status of the ci_hooks stand-in. Never set these in .env.
# STUB_INDEX_LOCK=index.lock
# STUB_HOLD=0
# STUB_EXIT_CI_HOOKS=0

# Set only by the infrastructure end-to-end stand-ins as the stand-in metadata token. Never set this in .env.
# BOOT_TOKEN=stand-in-token

# Set by ECS inside each task. The owner leaves it empty on the Mac.
# AWS_EXECUTION_ENV=

# Set by ECS inside each task. The owner leaves it empty on the Mac.
# AWS_CONTAINER_CREDENTIALS_RELATIVE_URI=

# Set by the ECS task definition. The owner leaves it empty on the Mac.
# HAI_DUCKDB_TEMP_DIRECTORY=

# Set by the ECS task definition. The owner leaves it empty on the Mac.
# HAI_DUCKDB_MAX_TEMP_BYTES=

# Set by the ECS task definition. The owner leaves it empty on the Mac.
# HAI_SPARK_LOCAL_DIRECTORY=
