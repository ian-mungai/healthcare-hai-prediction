AWS_REGION=your-aws-region
AWS_PROFILE=example_project_dev
AWS_ACCOUNT_ID=your-aws-account-id
PROJECT_NAME=example_project
ENVIRONMENT=dev
S3_BUCKET=your-s3-bucket

# Set by pre-commit only when it checks a commit range; never set these in .env.
# The removed-names check in scripts/quality/repo_checks.py diffs that range.
# PRE_COMMIT_FROM_REF=origin/main
# PRE_COMMIT_TO_REF=HEAD

# Git sets this to : for unedited commit messages; never set it in .env.
# GIT_EDITOR=:

# Set by the launcher inside the lakehouse Spark container from AWS Secrets Manager (scripts/lakehouse/catalog.py stores them
# there); never set these in .env.
# POLARIS_URI=http://polaris:8181/api/catalog
# POLARIS_CLIENT_ID=root
# POLARIS_CLIENT_SECRET=

# Set by the launcher in the lineage database dump job from AWS Secrets Manager (services/lineage/db_dump.py reads it); never set it in .env.
# MARQUEZ_DB_PASSWORD=

# Set by scripts/lakehouse/catalog.py for each Spark job from the memory free at launch (scripts/lakehouse/memory_budget.py);
# scripts/lakehouse/session.py requires it and has no default. Never set it in .env.
# SPARK_JOB_MEMORY=20g

# Computed per launch by scripts/lakehouse/memory_budget.py; never set these in .env.
# JOB_MEMORY_LIMIT=21474836480
# DUCKDB_MEMORY_LIMIT=17GB
# JOB_THREADS=16

# Passed by a launcher client to the jobs it starts: the allocation a kit command inherits (orchestration/launcher.py
# allocate prints its ID) and the absolute deadline the launcher fixes in a finite job's container (epoch seconds, read by
# services/hai/deadline_run.py); never set these in .env. A run's token lives in the token store, not in the environment.
# The run lock command line (scripts/lakehouse/run_lock.py) still reads the token of a run it acquired from RUN_LOCK_TOKEN.
# RUN_LOCK_TOKEN=
# HAI_ALLOCATION=al-0123456789ab
# HAI_DEADLINE_UTC=1791800000

# Names the Docker socket as the Docker command does (orchestration/launcher.py); unset, the launcher reads the current Docker
# context. Never set it in .env.
# DOCKER_HOST=unix:///var/run/docker.sock

# Supplied by the operating system and preserved by launch/check scripts; never set this in .env.
# PATH=/example/tool/bin

# Optional, for a faster local loop only: iteration runs each offline acquisition E2E suite once and marks the run
# "not commit evidence" (scripts/acquisition/tests/test_offline_e2e.py). The hook and CI always use full.
# ACQUISITION_E2E_MODE=full

# Set only by the reference-documents E2E (scripts/acquisition/run_reference_documents_e2e.py): it puts its
# offline stand-in first for the download processes it starts and restores the earlier value after. Never set it in .env.
# PYTHONPATH=
