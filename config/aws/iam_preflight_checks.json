        "roles.tf",
        "broker.tf"
      ],
      "policies": [
        "owner_policies/task_execution.json",
        "owner_policies/broker_parameter.json"
      ]
    },
    "job_read": {
      "name": "${PROJECT_NAME}_job_read_task_${ENVIRONMENT}",
      "terraform": [
