          "resource": "drift_task",
          "flag": "drift_prepared"
        },
        {
          "policy": "owner_policies/job_dvc_baseline_read.json",
          "resource": "drift_task",
          "flag": "drift_prepared"
        },
        {
          "policy": "owner_policies/drift_records.json",
          "resource": "drift_task",
          "flag": "drift_prepared"
        }
      ]
    }
