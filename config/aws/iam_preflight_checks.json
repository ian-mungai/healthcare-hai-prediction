{
  "roles": {
    "reader": {
      "name": "${LAKEHOUSE_READER_ROLE_NAME}",
      "terraform": [
        "roles.tf"
      ],
      "policies": [
        "role_policies/reader.json"
      ]
    },
    "writer": {
      "name": "${LAKEHOUSE_WRITER_ROLE_NAME}",
      "terraform": [
        "roles.tf"
      ],
      "policies": [
        "role_policies/writer.json"
      ]
    },
    "job_execution": {
      "name": "${PROJECT_NAME}_job_execution_${ENVIRONMENT}",
      "terraform": [
        "job_roles.tf",
        "job_writer.tf",
        "training.tf"
      ],
      "policies": [
        "owner_policies/job_execution.json",
        "owner_policies/job_writer_execution.json",
        "owner_policies/job_train_parameter.json"
      ]
    },
    "task_execution": {
      "name": "${PROJECT_NAME}_task_execution_${ENVIRONMENT}",
