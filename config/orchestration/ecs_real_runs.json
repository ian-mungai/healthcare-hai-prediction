{
  "schema_version": 1,
  "proof": "A",
  "artifact_root": "data/e2e/ecs_target",
  "result_file_max_bytes": 33554432,
  "preparation_only": true,
  "cloud_limits": {
    "max_tasks": 3,
    "max_vcpu": 16,
    "max_memory_gib": 120
  },
  "forbidden_actions": [
    "dataset_upload_from_mac",
    "canonical_source_mutation",
    "real_secret_rotation",
    "shared_catalog_failure",
    "iam_weakening",
    "mac_catalog_preparation_before_native_acceptance"
  ],
  "observed_only": [
    "untagged_task",
    "startup_failure",
    "stop_failure",
    "real_catalog_outage"
  ],
  "cleanup_observations": [
    "all_owned_tasks_stopped",
    "unconfirmed_tasks_still_counted",
    "current_object_delete_markers",
    "remaining_versions_listed",
    "no_incomplete_multipart_uploads",
    "no_owned_local_processes",
    "no_shared_endpoint_disabled_while_in_use"
  ],
  "runs": {
    "R1": {
      "name": "identity_and_reads",
      "outer_deadline_seconds": 7200,
      "first_step_task_count": 2,
      "steps": [
        {
          "name": "identity_and_grant_isolation",
          "observations": [
            "two_distinct_task_sessions",
            "session_suffix_matches_task_id",
            "terraform_role_id_matches_session",
            "own_grant_allowed",
            "other_task_grant_denied",
            "known_upstream_grant_denied",
            "task_role_write_denied",
            "grant_write_outside_try_denied",
            "conditional_write_without_header_denied"
          ]
        },
        {
          "name": "registered_source_reads",
          "observations": [
            "catalog_host_and_private_ip_match",
            "both_prerequisite_publishes_accepted",
            "registered_table_uuids_and_snapshots_match",
            "reader_pair_bound_by_action",
            "versioned_parameter_reads_succeed_without_values_saved",
            "actual_s3_versions_and_task_hashes_match",
            "five_fixed_read_definitions_and_image_pins_match",
            "same_arm64_digest_and_descriptor_portability_evidence"
          ]
        },
        {
          "name": "class_networks",
          "observations": [
            "lakehouse_catalog_and_s3_allowed",
            "offline_catalog_denied",
            "redis_denied_for_both_classes",
            "internet_and_unrelated_hosts_denied",
            "native_mac_container_route_evidence_or_gate_blocked",
            "mac_preparation_remains_disabled"
          ]
        },
        {
          "name": "limits_and_records",
          "observations": [
            "aws_first_dispatch_forced_ecs",
            "fixed_cloud_limits_and_pending_unknown_accounting",
            "each_task_hard_deadline_and_confirmed_stop",
            "budget_alert_is_not_spend_stop",
            "start_df_size_and_used_bytes",
            "task_metadata_storage_bytes",
            "both_image_footprints_and_margin_recorded",
            "each_claimed_cloud_ci_suite_has_native_container_evidence",
            "sanitized_results_at_most_32_mib"
          ]
        },
        {
          "name": "accept_and_release",
          "observations": [
            "live_try_only_applied",
            "seal_and_export_acceptance",
            "release_and_multipart_cleanup_recorded",
            "lifecycle_expiration_reported_as_configuration_only"
          ]
        }
      ]
    },
    "R2": {
      "name": "capacity_and_stop",
      "outer_deadline_seconds": 3600,
      "first_step_task_count": 1,
      "steps": [
        {
          "name": "approved_effect_free_diagnostics",
          "observations": [
            "forced_on_demand_task",
            "missing_propagate_tags_denied",
            "task_level_failure_isolated_from_shared_catalog"
          ]
        },
        {
          "name": "deadline_and_cancel",
          "observations": [
            "fixed_absolute_deadline_preserved",
            "deadline_stops_task_and_confirms_stopped",
            "cancel_during_provisioning_or_running",
            "stop_failure_observed_only_if_it_occurs"
          ]
        },
        {
          "name": "parallel_admission",
          "observations": [
            "one_mac_heavy_job_with_multiple_aws_jobs",
            "fixed_cap_counts_pending_running_and_unknown",
            "excess_admission_refused_before_run_task",
            "mac_lock_held_until_local_child_absent",
            "cleanup_does_not_stop_other_job"
          ]
        },
        {
          "name": "permitted_nonwrite_fallback",
          "observations": [
            "only_measured_approved_aws_bottleneck",
            "pending_cloud_try_fenced_before_mac_admission",
            "busy_mac_wait_uses_original_deadline",
            "application_integrity_credentials_never_trigger_fallback",
            "write_class_never_placed_on_mac",
            "fallback_is_not_cloud_acceptance"
          ]
        }
      ]
    },
    "R3": {
      "name": "gold_spill",
      "outer_deadline_seconds": 14400,
      "first_step_task_count": 1,
      "steps": [
        {
          "name": "storage_refusal",
          "observations": [
            "controlled_storage_refusal_precedes_actual_build",
            "no_synthetic_large_input_or_mac_dataset_upload"
          ]
        },
        {
          "name": "actual_gold_workload",
          "observations": [
            "existing_published_silver_snapshot_inventory",
            "actual_cloud_silver_extract",
            "actual_gold_import_and_dbt_build",
            "task_side_transfer_hash_scan_rates_and_units",
            "nonzero_duckdb_spill_peak_from_build_connection",
            "minimum_free_disk_and_storage_left_after_images_inputs_outputs",
            "compressed_and_unpacked_images_scratch_and_buffers_counted"
          ]
        },
        {
          "name": "timing_and_spill_gates",
          "observations": [
            "staging_at_most_quarter_of_step",
            "chain_at_most_1800_seconds",
            "spill_peak_at_most_half_remaining_storage",
            "minimum_disk_margin_at_least_five_gib",
            "measured_headroom_and_stage_allowance_decision",
            "unproven_spill_or_failed_threshold_holds_acceptance"
          ]
        },
        {
          "name": "portable_references_and_release",
          "observations": [
            "approved_portable_input_preserves_versions_hashes_paths",
            "controller_results_bounded_and_without_source_rows",
            "source_inventory_and_measurements_available_for_independent_audit",
            "release_and_cleanup_recorded"
          ]
        }
      ]
    }
  }
}
