{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthcare-hai-prediction.invalid/orchestration/ecs_broker_jobs.schema.json",
  "title": "ECS broker jobs",
  "description": "The closed table of the lean ECS broker. A step names its job, or null when the broker answers it without a task. A job names its deadline, the container whose log the logs route shows and the variables each container receives.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "jobs",
    "steps"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "jobs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{1,30}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deadline_seconds",
          "log_container",
          "network",
          "containers"
        ],
        "properties": {
          "network": {
            "enum": [
              "lakehouse",
              "training"
            ]
          },
          "deadline_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400
          },
          "log_container": {
            "type": "string"
          },
          "needs_training_parameters": {
            "const": true
          },
          "containers": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "RUN_ID",
                  "CODE_RUN_ID",
                  "CODE_SHA256",
                  "TRAINING_PARAMETERS",
                  "POLARIS_URI",
                  "MLFLOW_TRACKING_URI",
                  "INPUT_RUN_ID",
                  "BRONZE_TABLES",
                  "BRONZE_TARGET",
                  "BRONZE_DRY_RUN",
                  "BRONZE_REQUEST_SHA256",
                  "BRONZE_INVENTORY_SHA256",
                  "HAI_DEADLINE_UTC",
                  "SERVING_REQUEST"
                ]
              }
            }
          },
          "chain": {
            "const": true,
            "description": "The job belongs to the bronze-triggered chain and runs only after the first silver and gold publishes are signed"
          },
          "after": {
            "type": "string",
            "description": "The job whose succeeded run the request's input_run_id must name"
          },
          "acceptance": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "Containers that hold the acceptance checks. Each must be in the task's report and exit 0"
          },
          "approval": {
            "const": "promotion",
            "description": "The job runs only with the owner's approval record for exactly this promotion in the run's staged inputs"
          },
          "needs_bronze_request": {
            "const": true,
            "description": "The run stages bronze_request.json beside its code archive. The broker reads and checks it before it starts the task and passes its values to the containers"
          },
          "needs_serving_request": {
            "const": true,
            "description": "The run stages serving_request.json beside its code archive. The broker reads and checks it before it starts the task, binds every attempt to the first one it checked and passes the request to the serve container"
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{1,40}$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
