{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthcare-hai-prediction.invalid/orchestration/broker_templates.schema.json",
  "title": "Broker templates",
  "description": "config/orchestration/broker_templates.json: for each Airflow-visible template name and mode, the network class, whether the mode is an intentional no-op and the launcher template the broker forwards it to, with its fixed arguments and parameters. The broker is a client of the launcher: it never describes a container (image, mounts, environment, user, limits); the launcher's closed template table does. A mode with neither a no-op nor a launcher row is refused with its reason.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "templates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "templates": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{1,40}$"
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/template"
      }
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "name"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "maxLength": 250,
          "pattern": "^(file|s3://[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]|iceberg://[A-Za-z0-9_.:-]+(/[A-Za-z0-9_.-]+)*)$(?![\\s\\S])"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?:[A-Za-z0-9_./:-]|\\{(?:run_id|mode|run_dir|build_file|checkout)\\})+$(?![\\s\\S])",
          "not": {
            "pattern": "(^|/)(\\.\\.|secrets?|\\.env|[^/]*\\.(key|pem))(/|$)"
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "inputs",
        "outputs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "inputs": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dataset"
          }
        },
        "outputs": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dataset"
          }
        }
      }
    },
    "class": {
      "enum": [
        "offline",
        "lakehouse_read",
        "lakehouse_write",
        "collector",
        "training",
        "serving"
      ]
    },
    "placeholder_text": {
      "type": "string",
      "pattern": "^([^{}]|\\{(run_id|mode|run_dir|build_file|checkout|input_run_id)\\})*$"
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/placeholder_text"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "args",
        "params",
        "lineage"
      ],
      "dependentRequired": {
        "records_build_file": [
          "build_file_result"
        ],
        "build_file_result": [
          "records_build_file"
        ]
      },
      "properties": {
        "template": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,40}$"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placeholder_text"
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "lineage": {
          "$ref": "#/$defs/lineage"
        },
        "records_build_file": {
          "$ref": "#/$defs/placeholder_text"
        },
        "build_file_result": {
          "$ref": "#/$defs/placeholder_text"
        },
        "requires_build_file": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "validated_by",
            "file"
          ],
          "properties": {
            "validated_by": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,40}$"
            },
            "file": {
              "$ref": "#/$defs/placeholder_text"
            }
          }
        },
        "dbt_nodes": {
          "type": "object",
          "maxProperties": 10000,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,249}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/dataset"
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "enum": [
            "acquire",
            "record",
            "gate_accepted",
            "gate_rejected",
            "release_accepted",
            "release_rejected",
            "catalog_up",
            "catalog_release",
            "snapshot_project",
            "reserve_silver",
            "seal_silver",
            "seal_gold",
            "fixture_pin",
            "fixture_verify"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seed": {
              "$ref": "#/$defs/placeholder_text"
            },
            "folders": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,40}$"
              },
              "minItems": 1
            },
            "record_file": {
              "$ref": "#/$defs/placeholder_text"
            },
            "build_files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/placeholder_text"
              },
              "minItems": 1
            },
            "expected_states": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "success",
                  "skipped"
                ]
              },
              "minProperties": 1
            }
          }
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "no_op"
      ],
      "properties": {
        "class": {
          "$ref": "#/$defs/class"
        },
        "no_op": {
          "type": "boolean"
        },
        "launcher": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/launcher"
            }
          ]
        },
        "control": {
          "$ref": "#/$defs/control"
        },
        "reason": {
          "type": "string",
          "minLength": 10
        }
      },
      "oneOf": [
        {
          "description": "an intentional no-op: no launcher row, the reason recorded",
          "properties": {
            "no_op": {
              "const": true
            }
          },
          "required": [
            "reason"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "launcher"
                ]
              },
              {
                "required": [
                  "control"
                ]
              }
            ]
          }
        },
        {
          "description": "forwarded to a launcher template",
          "properties": {
            "no_op": {
              "const": false
            },
            "launcher": {
              "type": "object"
            }
          },
          "required": [
            "launcher"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "reason"
                ]
              },
              {
                "required": [
                  "control"
                ]
              }
            ]
          }
        },
        {
          "description": "no launcher row (yet): refused with this reason",
          "properties": {
            "no_op": {
              "const": false
            },
            "launcher": {
              "type": "null"
            }
          },
          "required": [
            "launcher",
            "reason"
          ],
          "not": {
            "required": [
              "control"
            ]
          }
        },
        {
          "description": "a run-control action the broker performs itself on the launcher's run methods",
          "properties": {
            "no_op": {
              "const": false
            }
          },
          "required": [
            "control"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "launcher"
                ]
              },
              {
                "required": [
                  "reason"
                ]
              }
            ]
          }
        }
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "modes"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 10
        },
        "modes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "fixture",
              "publish_fixture",
              "real"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/mode"
          }
        }
      }
    }
  }
}
