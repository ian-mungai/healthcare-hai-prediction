{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cloud placement rollout",
  "description": "The closed read-job allowlist. Enabling placement also requires the reviewed nonblocking execution facade.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "enabled", "jobs"],
  "properties": {
    "version": {"const": 1},
    "enabled": {"type": "boolean"},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template", "class"],
        "properties": {
          "template": {"enum": ["pipeline_dbt", "pipeline_validate_silver", "pipeline_validate_gold", "pipeline_validate_cross", "pipeline_export", "pipeline_spark", "pipeline_publish"]},
          "layer": {"enum": ["silver", "gold"]},
          "class": {"enum": ["offline", "lakehouse_read"]}
        }
      }
    }
  }
}
