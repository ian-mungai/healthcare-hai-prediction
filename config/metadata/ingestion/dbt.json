{
  "hai_glue_mapping": {
    "database": "hai_lakehouse",
    "schemas": {
      "silver": "hai_mirror_silver",
      "gold": "hai_mirror_gold",
      "features": "hai_mirror_features"
    }
  },
  "source": {
    "type": "dbt",
    "serviceName": "glue_mirror",
    "sourceConfig": {
      "config": {
        "type": "DBT",
        "dbtConfigSource": {
          "dbtConfigType": "local",
          "dbtManifestFilePath": "${DBT_ARTIFACT_DIR}/manifest.json",
          "dbtCatalogFilePath": "${DBT_ARTIFACT_DIR}/catalog.json",
          "dbtRunResultsFilePath": "${DBT_ARTIFACT_DIR}/run_results.json"
        }
      }
    }
  },
  "sink": {
    "type": "metadata-rest",
    "config": {}
  },
  "workflowConfig": {
    "loggerLevel": "INFO",
    "openMetadataServerConfig": {
      "hostPort": "http://127.0.0.1:8585/api",
      "authProvider": "openmetadata",
      "securityConfig": {
        "jwtToken": "${OM_INGESTION_TOKEN}"
      }
    }
  }
}
