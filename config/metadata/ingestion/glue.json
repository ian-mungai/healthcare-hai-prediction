{
  "source": {
    "type": "glue",
    "serviceName": "glue_mirror",
    "serviceConnection": {
      "config": {
        "type": "Glue",
        "awsConfig": {
          "awsRegion": "${AWS_REGION}"
        },
        "databaseName": "hai_lakehouse"
      }
    },
    "sourceConfig": {
      "config": {
        "type": "DatabaseMetadata",
        "includeTables": true,
        "includeViews": false,
        "schemaFilterPattern": {
          "includes": [
            "^hai_mirror_silver$",
            "^hai_mirror_gold$",
            "^hai_mirror_features$"
          ]
        }
      }
    }
  },
  "sink": {
    "type": "metadata-rest",
    "config": {}
  },
  "workflowConfig": {
    "loggerLevel": "INFO",
    "openMetadataServerConfig": {
      "hostPort": "http://127.0.0.1:8585/api",
      "authProvider": "openmetadata",
      "securityConfig": {
        "jwtToken": "${OM_INGESTION_TOKEN}"
      }
    }
  }
}
