  "cards": [
    {
      "dot": "cyan",
      "title": "Acquisition",
      "items": [
        "Publisher APIs first, then download URLs; manual export only by choice",
        "Locked plans and reviewed code versions gate every new capture",
        "Raw responses kept byte for byte; CSVs derived and replayed offline"
      ]
    },
    {
      "dot": "rose",
      "title": "Storage and access",
      "items": [
        "One versioned, encrypted, TLS-only bucket with public access blocked",
        "Project user: write-once raw data, lakehouse/ read-write, shared keys read-only",
        "Originals with personal data stay local with owner-only access",
        "Replaced lakehouse/ versions expire after 30 days; nothing else expires",
        "Deferred: access logging, KMS, replication, event notifications"
      ]
    },
    {
      "dot": "emerald",
      "title": "Lakehouse",
      "items": [
        "Bronze reads only the S3 manifests and the committed table map",
        "One copy per stored file; bronze.stored_copies lists every copy",
        "Each row traces to its S3 key, version and SHA-256",
        "dbt staging keeps one row per HAI measurement window"
      ]
    },
    {
      "dot": "violet",
      "title": "Verification",
      "items": [
        "Commits and GitHub Actions run the same pre-commit hooks, without AWS credentials",
        "Ruff, MyPy, SQLFluff, secret scan, repository and cleanup checks",
        "Terraform plans are tested with a mock provider; tflint, checkov, trivy",
        "E2E runs leave repeatable artifacts under data/e2e",
        "Every component cites the source lines it was checked against"
      ]
    },
    {
      "dot": "amber",
      "title": "Planned (not built)",
      "items": [
        "Orchestration with scheduled DAGs",
        "Gold star schema at atomic grain (dbt dim_ and fct_); silver refactor to standard cleansing",
        "Feature store, MLflow model comparison and external validation"
      ]
    }
  ]
