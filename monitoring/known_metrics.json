{
  "note": "Metrics that the dashboard and the alerts may name besides the ones monitoring/statsd/mapping.yml produces. Each entry says who emits it, so the check can tell a typo from a metric nothing sends.",
  "prometheus": {
    "emitted_by": "Prometheus itself, scraped as the prometheus job",
    "metrics": ["prometheus_tsdb_storage_blocks_bytes", "prometheus_tsdb_retention_limit_bytes", "up"]
  },
  "statsd_exporter": {
    "emitted_by": "the StatsD exporter itself, scraped as the statsd_exporter job",
    "metrics": ["statsd_exporter_events_actions_total"]
  },
  "hai_api": {
    "emitted_by": "the model API, scraped as the hai_api job on 127.0.0.1:8000. It must expose these names and labels, or the contract here changes.",
    "metrics": {
      "hai_api_requests_total": {"type": "counter", "labels": ["route", "method", "status"]},
      "hai_api_request_duration_seconds": {"type": "histogram", "labels": ["route"]}
    }
  },
  "pushgateway": {
    "emitted_by": "the host jobs themselves, pushed at start, by heartbeat and at exit (scripts/metrics_push.py) to the Pushgateway and scraped as the pushgateway job with honor_labels, so job, phase and outcome are the grouping keys the job pushed. The list must equal the CATALOG of that module.",
    "metrics": {
      "hai_job_start_timestamp_seconds": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_job_heartbeat_timestamp_seconds": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_job_memory_current_bytes": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_job_memory_peak_bytes": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_job_scratch_peak_bytes": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_job_finish_timestamp_seconds": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_job_duration_seconds": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_job_exit_code": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_job_peak_memory_bytes": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_job_peak_scratch_bytes": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_drift_status": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type", "status"]},
      "hai_drift_share": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type"]},
      "hai_drift_features_drifted": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type"]},
      "hai_drift_triggered": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type"]},
      "hai_drift_current_rows": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type"]},
      "hai_drift_unmonitored": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type"]},
      "hai_feature_set_publish_timestamp_seconds": {"type": "gauge", "labels": ["job", "phase", "outcome", "feature_set"]},
      "hai_feature_set_online_mode": {"type": "gauge", "labels": ["job", "phase", "outcome", "feature_set", "mode"]},
      "hai_feature_reload_result": {"type": "gauge", "labels": ["job", "phase", "outcome", "feature_set", "result"]},
      "hai_feature_release_result": {"type": "gauge", "labels": ["job", "phase", "outcome", "feature_set", "result"]},
      "hai_spark_stages_active": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_spark_tasks_running": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_spark_tasks_completed": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_spark_tasks_failed": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_spark_jobs_running": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_spark_jobs_completed": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_spark_jobs_failed": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_spark_poll_timestamp_seconds": {"type": "gauge", "labels": ["job", "phase", "outcome"]},
      "hai_dbt_models": {"type": "gauge", "labels": ["job", "phase", "outcome", "status"]},
      "hai_dbt_tests": {"type": "gauge", "labels": ["job", "phase", "outcome", "status"]},
      "hai_quality_checks_run": {"type": "gauge", "labels": ["job", "phase", "outcome", "kind"]},
      "hai_quality_checks_failed": {"type": "gauge", "labels": ["job", "phase", "outcome", "kind"]},
      "hai_quality_checks_warned": {"type": "gauge", "labels": ["job", "phase", "outcome", "kind"]},
      "hai_openmetadata_ingest_entities": {"type": "gauge", "labels": ["job", "phase", "outcome", "source"]},
      "hai_openmetadata_ingest_failures": {"type": "gauge", "labels": ["job", "phase", "outcome", "source"]},
      "hai_training_holdout_rmse": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type", "model", "slot"]},
      "hai_training_selected": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type", "model", "slot"]},
      "hai_training_challenger_registered": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type", "model"]},
      "hai_research_candidate_rmse": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type", "model"]},
      "hai_research_eligible_candidates": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type"]},
      "hai_research_challenger": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type"]},
      "hai_research_challenger_model": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type", "model"]},
      "hai_research_production_version": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type"]},
      "hai_canary_result": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type", "decision"]},
      "hai_promotion_executed": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type", "action"]},
      "hai_promotion_version": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type"]},
      "hai_promotion_notice": {"type": "gauge", "labels": ["job", "phase", "outcome", "hai_type", "verdict"]},
      "hai_promotion_result": {"type": "gauge", "labels": ["job", "phase", "outcome", "result"]}
    }
  },
  "pushgateway_itself": {
    "emitted_by": "the Pushgateway itself, scraped as the pushgateway job",
    "metrics": ["push_time_seconds", "push_failure_time_seconds"]
  },
  "host_state_exporter": {
    "emitted_by": "the host state exporter (monitoring/host_state_exporter.py), scraped as the host_state_exporter job on 127.0.0.1:9103. The list must equal the CATALOG of that module.",
    "metrics": {
      "hai_host_instances": {"type": "gauge", "labels": []},
      "hai_host_memory_registered_mib": {"type": "gauge", "labels": []},
      "hai_host_memory_remaining_mib": {"type": "gauge", "labels": []},
      "hai_host_cpu_registered_units": {"type": "gauge", "labels": []},
      "hai_host_cpu_remaining_units": {"type": "gauge", "labels": []},
      "hai_host_running_tasks": {"type": "gauge", "labels": []},
      "hai_host_job_cap_mib": {"type": "gauge", "labels": []},
      "hai_service_tasks_desired": {"type": "gauge", "labels": ["service"]},
      "hai_service_tasks_running": {"type": "gauge", "labels": ["service"]},
      "hai_service_tasks_pending": {"type": "gauge", "labels": ["service"]},
      "hai_service_tasks_stopped_recent": {"type": "gauge", "labels": ["service", "stop_code"]},
      "hai_service_probe_up": {"type": "gauge", "labels": ["probe", "service"]},
      "hai_service_probe_seconds": {"type": "gauge", "labels": ["probe", "service"]},
      "hai_host_disk_free_bytes": {"type": "gauge", "labels": ["volume"]},
      "hai_host_disk_total_bytes": {"type": "gauge", "labels": ["volume"]},
      "hai_host_scratch_separate_volume": {"type": "gauge", "labels": []},
      "hai_openmetadata_healthy": {"type": "gauge", "labels": []},
      "hai_openmetadata_check_healthy": {"type": "gauge", "labels": ["check"]},
      "host_state_exporter_source_up": {"type": "gauge", "labels": ["source"]},
      "host_state_exporter_source_errors_total": {"type": "counter", "labels": ["source"]},
      "host_state_exporter_source_last_success_timestamp_seconds": {"type": "gauge", "labels": ["source"]}
    }
  },
  "redis_exporter": {
    "emitted_by": "the Redis exporter, scraped as the redis_exporter job on 127.0.0.1:9121",
    "metrics": ["redis_up", "redis_memory_used_bytes", "redis_memory_max_bytes", "redis_connected_clients", "redis_evicted_keys_total", "redis_db_keys"]
  },
  "postgres_exporter": {
    "emitted_by": "the Postgres exporter, scraped as the postgres_exporter job on 127.0.0.1:9187",
    "metrics": ["pg_up", "pg_stat_database_numbackends", "pg_settings_max_connections", "pg_database_wraparound_age_datfrozenxid_seconds"]
  },
  "node_exporter": {
    "emitted_by": "the node exporter with the restricted collectors, scraped as the node_exporter job on 127.0.0.1:9100",
    "metrics": ["node_vmstat_oom_kill", "node_filesystem_avail_bytes", "node_filesystem_size_bytes", "node_memory_MemAvailable_bytes", "node_load1"]
  },
  "polaris": {
    "emitted_by": "Polaris (Quarkus) on its management port, scraped as the polaris job",
    "metrics": []
  }
}
