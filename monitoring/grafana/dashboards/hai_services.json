{
  "uid": "hai_services",
  "title": "HAI services and disk",
  "description": "ECS services, their health endpoints and the host volumes, read live by the host state exporter.",
  "tags": [
    "hai"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "ECS services",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tasks running and desired, by service",
      "description": "From ECS, read live.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "hai_service_tasks_running",
          "legendFormat": "{{service}} running"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "hai_service_tasks_desired",
          "legendFormat": "{{service}} desired"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tasks pending, by service",
      "description": "Tasks that ECS is starting.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "hai_service_tasks_pending",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tasks stopped in the last hour, by service and stop code",
      "description": "What ECS still lists as stopped. Empty while nothing stopped.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "hai_service_tasks_stopped_recent",
          "legendFormat": "{{service}} {{stop_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Health endpoints",
      "id": 5,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Health endpoint up, by service",
      "description": "1 when the endpoint answered with an accepted status.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "hai_service_probe_up",
          "legendFormat": "{{probe}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Health endpoint answer time",
      "description": "Seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "hai_service_probe_seconds",
          "legendFormat": "{{probe}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Disk",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Free bytes, by volume",
      "description": "The data volume and the job scratch volume.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "hai_host_disk_free_bytes",
          "legendFormat": "{{volume}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Free share, by volume",
      "description": "Free bytes over total bytes.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "hai_host_disk_free_bytes / hai_host_disk_total_bytes",
          "legendFormat": "{{volume}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Scratch folder on its own volume",
      "description": "1 when the job scratch folder has a volume of its own, 0 when it shares the data volume.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "hai_host_scratch_separate_volume",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Streamlit, Evidently UI and OpenSearch",
      "id": 12,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Streamlit and Evidently UI",
      "description": "Health endpoint of each UI: 1 up, 0 down. The Evidently UI shows 2 (disabled) while its switch is off, which is not down.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "hai_service_probe_up{probe=~\"streamlit|evidently_ui\"} or hai_service_probe_disabled{probe=\"evidently_ui\"} * 2",
          "legendFormat": "{{probe}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "up",
                  "index": 1
                }
              }
            },
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "disabled",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "OpenSearch cluster status",
      "description": "Status of the OpenSearch cluster: 0 green, 1 yellow, 2 red.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "hai_opensearch_cluster_status",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "yellow",
                  "index": 1
                }
              }
            },
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "red",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "One-shot bootstrap tasks",
      "id": 15,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Last exit code, by one-shot task",
      "description": "Exit code of the latest run of each one-shot task (code fetch, Polaris bootstrap, OpenMetadata bootstrap). 0 is success, -1 means no exit code was recorded.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "hai_bootstrap_task_last_exit_code",
          "legendFormat": "{{task}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Seconds since the last run, by one-shot task",
      "description": "Seconds since the latest run of each one-shot task stopped.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "time() - hai_bootstrap_task_last_run_timestamp_seconds",
          "legendFormat": "{{task}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
