    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Checks warned, by gate",
      "description": "Warnings stop a publish too.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
