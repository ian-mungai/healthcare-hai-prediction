{
  "uid": "hai_data_quality",
  "title": "HAI data quality",
  "description": "dbt builds and quality gates of the layer jobs, pushed by the jobs themselves.",
  "tags": [
    "hai"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "dbt",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Models of the latest dbt build, by layer and status",
      "description": "Models built, failed or skipped.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "max by (job, status) (hai_dbt_models)",
          "legendFormat": "{{job}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tests of the latest dbt build, by layer and status",
      "description": "Passed, warned or failed tests.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "max by (job, status) (hai_dbt_tests)",
          "legendFormat": "{{job}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Quality gates",
      "id": 4,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Checks run, by gate",
      "description": "Quality checks of the latest validation.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "max by (job, kind) (hai_quality_checks_run)",
          "legendFormat": "{{job}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Checks failed, by gate",
      "description": "Zero for a layer that can publish.",
