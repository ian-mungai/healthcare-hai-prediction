{
  "uid": "hai_feature_store",
  "title": "HAI feature store",
  "description": "Feature publish and online store state, pushed by the features jobs.",
  "tags": [
    "hai"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Publish",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Online mode of the latest publish, by feature set",
      "description": "Load, hold or offline.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "max by (feature_set, mode) (hai_feature_set_online_mode)",
          "legendFormat": "{{feature_set}} {{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Seconds since the latest publish, by feature set",
      "description": "From the time the Feast materialize step finished.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "time() - max by (feature_set) (hai_feature_set_publish_timestamp_seconds)",
          "legendFormat": "{{feature_set}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Online store",
      "id": 4,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Result of the latest reload, by feature set",
      "description": "Loaded, already loaded or skipped, from the reload container at host start.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "max by (feature_set, result) (hai_feature_reload_result)",
          "legendFormat": "{{feature_set}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Result of the latest release, by feature set",
      "description": "Empty until a held online load is released.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "max by (feature_set, result) (hai_feature_release_result)",
          "legendFormat": "{{feature_set}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
