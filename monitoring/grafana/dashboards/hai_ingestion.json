{
  "uid": "hai_ingestion",
  "title": "HAI ingestion",
  "description": "The latest publisher run: units, files, bytes and the data sources, pushed by the publisher task.",
  "tags": [
    "hai"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Latest publisher run",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Units by state",
      "description": "Units of the latest run by state.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "max by (state) (hai_publisher_units{job=\"publisher\"})",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Files fetched and files missing",
      "description": "Fetched = completed, unchanged and changed units. Missing = failed, refused or not attempted units, by run kind.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "max (hai_publisher_files_fetched{job=\"publisher\"})",
          "legendFormat": "fetched"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "max by (run_kind) (hai_publisher_files_missing{job=\"publisher\"})",
          "legendFormat": "missing {{run_kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bytes downloaded",
      "description": "Bytes the latest run downloaded, which is the bytes it stored.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "max (hai_publisher_bytes_downloaded{job=\"publisher\"})",
          "legendFormat": "bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Requests, objects and evidence",
      "id": 5,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP requests and objects created",
      "description": "From the run counters.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "max (hai_publisher_http_requests{job=\"publisher\"})",
          "legendFormat": "requests"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "max (hai_publisher_objects_created{job=\"publisher\"})",
          "legendFormat": "objects created"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Evidence problems",
      "description": "Problems the evidence check found in the latest run.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "max (hai_publisher_evidence_problems{job=\"publisher\"})",
          "legendFormat": "problems"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Data sources",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Age of the last success, by data source",
      "description": "Seconds since the latest run that fetched the source with no unit failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "time() - max by (data_source) (hai_publisher_source_last_success_timestamp_seconds{job=\"publisher\"})",
          "legendFormat": "{{data_source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Unfinished units, by data source",
      "description": "Units that failed or were refused in the latest run.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "max by (data_source) (hai_publisher_source_units_unfinished{job=\"publisher\"})",
          "legendFormat": "{{data_source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Bronze stage",
      "id": 11,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Tables the latest bronze stage left out",
      "description": "Tables of the pipeline run that the bronze stage left out because they have no raw files.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "max (hai_bronze_stage_skipped_tables{job=\"bronze\", phase=\"stage\"})",
          "legendFormat": "skipped tables"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
