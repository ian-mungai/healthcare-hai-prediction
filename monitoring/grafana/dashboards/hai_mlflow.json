{
  "uid": "hai_mlflow",
  "title": "HAI MLflow",
  "description": "Request rate, errors and latency of the MLflow tracking and registry server, from its own metrics. MLflow 3.17.2 labels these series by method and status only, so there is no panel by route, and run creation, logging and model alias calls cannot be told apart.",
  "tags": [
    "hai"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Requests",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Request rate",
      "description": "Requests per second to the tracking and registry API. The health, version and metrics paths are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "sum(rate(mlflow_http_request_total{job=\"mlflow\"}[$__rate_interval]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Server error ratio (5xx)",
      "description": "The share of requests answered with a 5xx status.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "(sum(rate(mlflow_http_request_total{job=\"mlflow\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(mlflow_http_request_total{job=\"mlflow\"}[$__rate_interval]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unhandled exceptions per second",
      "description": "Requests that ended in an exception inside MLflow.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "sum(rate(mlflow_http_request_exceptions_total{job=\"mlflow\"}[$__rate_interval])) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Unauthorized requests (401) per second",
      "description": "Requests that the basic-auth layer refused, such as a wrong or missing password.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "sum(rate(mlflow_http_request_total{job=\"mlflow\",status=\"401\"}[$__rate_interval])) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Client errors (4xx) and server errors (5xx) per second",
      "description": "A 4xx status is a refused or bad request; a 5xx status is a failure inside MLflow.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "sum(rate(mlflow_http_request_total{job=\"mlflow\",status=~\"4..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "4xx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "sum(rate(mlflow_http_request_total{job=\"mlflow\",status=~\"5..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests per second by status",
      "description": "One series per status code that MLflow answered.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "sum by (status) (rate(mlflow_http_request_total{job=\"mlflow\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests per second by method",
      "description": "GET reads runs and models; POST and PUT create and log them.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "sum by (method) (rate(mlflow_http_request_total{job=\"mlflow\"}[$__rate_interval]))",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Latency",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Latency, 95th percentile",
      "description": "95% of requests finished within this time. The buckets are the prometheus-client defaults, from 5 ms to 10 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mlflow_http_request_duration_seconds_bucket{job=\"mlflow\"}[$__rate_interval])))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Latency by method, 95th percentile",
      "description": "The 95th percentile for each HTTP method.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(mlflow_http_request_duration_seconds_bucket{job=\"mlflow\"}[$__rate_interval])))",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Mean latency",
      "description": "Total request time divided by the request count.",
      "datasource": {
        "type": "prometheus",
        "uid": "hai_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hai_prometheus"
          },
          "expr": "sum(rate(mlflow_http_request_duration_seconds_sum{job=\"mlflow\"}[$__rate_interval])) / sum(rate(mlflow_http_request_duration_seconds_count{job=\"mlflow\"}[$__rate_interval]))",
          "legendFormat": "mean"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
